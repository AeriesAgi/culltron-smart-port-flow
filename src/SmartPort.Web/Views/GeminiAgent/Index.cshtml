@model SmartPort.Application.DTOs.FleetQueueSummaryDto
@using SmartPort.Infrastructure.Services
@{
    ViewData["Title"] = "Gemini Operations Agent";
    var status = ViewBag.Status as AgentModeStatus ?? new AgentModeStatus();
    var readiness = ViewBag.Readiness as SmartPort.Web.Controllers.GeminiReadinessViewModel ?? new SmartPort.Web.Controllers.GeminiReadinessViewModel(false, false, "Hybrid demo", "gemini-2.5-flash", "Deterministic fallback active", "No generation yet", null);
    var intelligence = ViewBag.Intelligence as SmartPort.Web.Controllers.OperationalIntelligenceViewModel ?? new SmartPort.Web.Controllers.OperationalIntelligenceViewModel(80, 72, 84, 76, 79, 82, 3, "Synthetic queue pressure", 48000, 91, 84);
    var history = ViewBag.History as IReadOnlyList<SmartPort.Web.Controllers.GeminiAgentHistoryItem> ?? Array.Empty<SmartPort.Web.Controllers.GeminiAgentHistoryItem>();
    var last = ViewBag.LastHistory as SmartPort.Web.Controllers.GeminiAgentHistoryItem;
    var geminiStatusLabel = readiness.Enabled && readiness.ApiKeyConfigured ? "Live Ready" : readiness.ApiKeyConfigured ? "Configured" : readiness.Enabled ? "Needs API Key" : "Fallback Active";
    var actions = new[] { "Run Live Gemini Test", "Gemini Operations Brief", "Fleet Owner Action Plan", "Driver Instruction Brief", "Disruption Recovery Plan", "Emissions/Idling Impact Brief", "Risk & Governance Review", "Executive Judge Summary" };
}
<section class="sp-page-hero">
  <div>
    <span class="sp-badge">Enterprise AI operations agent · synthetic demo data · connector-ready pilots</span>
    <h1>Gemini Operations Agent Console</h1>
    <p>Smart Port turns port signals into execution plans, fleet actions, driver companion updates, mobile API calls, audit records and emissions/idling impact. Gemini is the on-demand AI agent layer; deterministic fallback always works.</p>
    <p class="sp-alert sp-alert--info">Gemini is an on-demand AI agent layer. It activates on operational events and user-triggered actions. Page loads and health checks do not consume Gemini quota. Premium judge actions use Gemini 2.5 Flash when available. Routine operational actions use configured lightweight Gemini models where available. If one model is rate-limited, Smart Port attempts configured fallback text models before using deterministic fallback.</p>
    @if (!readiness.ApiKeyConfigured || !readiness.Enabled)
    {
      <p class="sp-alert sp-alert--info">Deterministic fallback active — add GEMINI_API_KEY to use Gemini on demand. Gemini is enabled by default and can be explicitly disabled with Gemini__Enabled=false.</p>
    }
  </div>
  <form method="post" action="/gemini-agent/generate">
    <input type="hidden" name="briefType" value="Gemini Operations Brief" />
    <button class="sp-btn sp-btn--primary">Generate Gemini Operations Brief</button>
  </form>
  <form method="post" action="/gemini-agent/generate">
    <input type="hidden" name="briefType" value="Live Gemini Connector Test" />
    <button class="sp-btn sp-btn--outline">Run Live Gemini Test</button>
  </form>
</section>

<div class="sp-grid sp-grid--4">
  <article class="sp-card"><h3>Gemini key present</h3><p class="sp-kpi">@(readiness.ApiKeyConfigured ? "Yes" : "No")</p><p>Yes/no only; key value is never displayed.</p></article>
  <article class="sp-card"><h3>Enabled</h3><p class="sp-kpi">@(readiness.Enabled ? "Yes" : "No")</p><p>Gemini__Enabled / GEMINI_ENABLED runtime flag.</p></article>
  <article class="sp-card"><h3>Mode & model plan</h3><p><strong>@readiness.Mode</strong></p><p>@readiness.Model</p></article>
  <article class="sp-card"><h3>Status/latency</h3><p class="sp-kpi">@geminiStatusLabel</p><p><strong>@readiness.FallbackStatus</strong></p><p>Last result: @readiness.LastGenerationStatus · @(readiness.LastLatencyMs?.ToString() ?? "n/a") ms</p><p>Output source: @(readiness.Enabled && readiness.ApiKeyConfigured ? "Gemini on demand / fallback guarded" : "Deterministic fallback")</p></article>
</div>
<section class="sp-card sp-mt">
  <h2>Safe Gemini diagnostics</h2>
  <p class="sp-muted">This panel is read-only and does not call Gemini. It exposes operational diagnostics without secrets.</p>
  <div class="sp-grid sp-grid--4">
    <p><strong>Model attempted</strong><br />@(string.IsNullOrWhiteSpace(status.LastModelAttempted) ? "No call attempted since startup" : status.LastModelAttempted)</p>
    <p><strong>Model used</strong><br />@(string.IsNullOrWhiteSpace(status.LastModelUsed) ? "No call used since startup" : status.LastModelUsed)</p>
    <p><strong>Fallback reason</strong><br />@readiness.FallbackStatus</p>
    <p><strong>Quota/model error</strong><br />@(status.QuotaLimited ? "quota-limited" : status.LastResult.Contains("unsupported", StringComparison.OrdinalIgnoreCase) || status.LastResult.Contains("unavailable", StringComparison.OrdinalIgnoreCase) ? status.LastResult : "none recorded")</p>
    <p><strong>Calls since startup/session</strong><br />@status.CallsSinceStart</p>
    <p><strong>Last call action</strong><br />@(string.IsNullOrWhiteSpace(status.LastActionType) ? "No explicit action yet" : status.LastActionType)</p>
    <p><strong>Last call result</strong><br />@(string.IsNullOrWhiteSpace(status.LastResult) ? "No result yet" : status.LastResult)</p>
    <p><strong>Deterministic fallback active</strong><br />@(status.FallbackActive || !status.GeminiEnabled || !status.GeminiConfigured ? "Yes" : "No")</p>
  </div>
</section>

<section class="sp-grid sp-grid--3 sp-mt">
  <article class="sp-card"><h2>Operational inputs</h2><ul class="sp-list"><li>Active truck queue count: <strong>@Model.TotalTrucks</strong></li><li>Gate pressure: <strong>@Model.TrucksWaiting waiting / @Model.TrucksHolding holding</strong></li><li>Berth/yard readiness: <strong>@Model.BerthReadiness.Count berth zones / @Model.StagingAreas.Count staging areas</strong></li><li>Active incidents/disruptions: <strong>@Model.DelayedOrRescheduledTrucks</strong></li><li>Driver confirmations: <strong>@Model.TrucksProceeding proceeding</strong></li><li>Driver notification timeline: <strong>@Model.LatestNotifications.Count recent events</strong></li><li>Emissions/idling estimate: <strong>@Model.TotalIdlingMinutesAvoided min / @Model.TotalCo2KgAvoided kg CO₂</strong></li><li>Execution plans: <strong>@(Model.LatestExecutionPlan?.PlanId[..8] ?? "generate to create")</strong></li><li>Data source mode: <strong>synthetic demo, live connector-ready</strong></li></ul></article>
  <article class="sp-card"><h2>Operational Intelligence Score</h2><p class="sp-kpi">@intelligence.OverallScore/100</p><ul class="sp-list"><li>Congestion risk: @intelligence.CongestionRisk</li><li>Execution readiness: @intelligence.ExecutionReadiness</li><li>Emissions impact: @intelligence.EmissionsImpact</li><li>Driver response state: @intelligence.DriverResponseState</li><li>Integration confidence: @intelligence.IntegrationConfidence</li><li>Data quality score: @intelligence.DataQualityScore</li><li>Connector readiness score: @intelligence.ConnectorReadinessScore</li></ul></article>
  <article class="sp-card"><h2>Business impact</h2><p><strong>Bottleneck reason:</strong> @intelligence.BottleneckReason</p><p><strong>ETA risk:</strong> @(Model.HighRiskTrucks.Count) high-risk trucks need action.</p><p><strong>Yard/gate pressure:</strong> Controlled release recommended.</p><p><strong>Trucks needing action:</strong> @intelligence.TrucksNeedingAction</p><p><strong>Execution plan ROI:</strong> R @intelligence.ExecutionPlanRoiRand.ToString("N0") synthetic demo value protected through less idling and fewer misses.</p></article>
</section>

<section class="sp-card sp-mt"><h2>Agent workflow trace</h2><ol class="sp-timeline"><li>Page load reads only synthetic/demo fleet, gate, staging, berth and notification signals; it does not call Gemini.</li><li>Detect bottleneck: @intelligence.BottleneckReason.</li><li>Generate deterministic baseline plan that can run without Gemini.</li><li>Only when a user clicks a Gemini/AI button, call the backend once with routine or premium task category.</li><li>Try the configured model chain, skip unsupported/quota-limited models, and fall back locally without retry loops.</li><li>Produce human-approved action plan for fleet owner and Driver Companion APK/web/mobile API channels.</li><li>Save audit entry with input signals, source model, recommendation and approval state.</li><li>WhatsApp is connector-ready/sandbox-live-test only; it is not required for judging.</li></ol></section>

<section class="sp-grid sp-grid--3 sp-mt"><article class="sp-card"><h2>Safe diagnostics</h2><ul class="sp-list"><li>Total Gemini calls since app start: <strong>@status.CallsSinceStart</strong></li><li>Last action: <strong>@(string.IsNullOrWhiteSpace(status.LastActionType) ? "none" : status.LastActionType)</strong></li><li>Last route/source: <strong>@(string.IsNullOrWhiteSpace(status.LastRouteSource) ? "none" : status.LastRouteSource)</strong></li><li>Last model used: <strong>@(string.IsNullOrWhiteSpace(status.LastModelUsed) ? "none" : status.LastModelUsed)</strong></li><li>Quota-limited: <strong>@(status.QuotaLimited ? "Yes" : "No")</strong></li><li>Fallback active: <strong>@(status.FallbackActive ? "Yes" : "No")</strong></li></ul></article><article class="sp-card"><h2>Controlled auto-run</h2><p>Agent page auto-run: <strong>@(status.AutoRunOnAgentPage ? "Enabled" : "Disabled by default")</strong></p><p>Demo tour auto-run: <strong>@(status.AutoRunOnDemoTour ? "Enabled" : "Disabled by default")</strong></p><p>Cooldown: <strong>@status.AutoRunCooldownMinutes minutes</strong>. Health, enterprise readiness, public pages, mobile status refreshes, and smoke tests never call Gemini.</p></article><article class="sp-card"><h2>Model plan</h2><p><strong>Premium:</strong> @status.PremiumModel</p><p><strong>Routine:</strong> @status.RoutineModel</p><p><strong>Fallback chain:</strong> @status.FallbackModels</p></article></section>

<section class="sp-card sp-mt"><h2>Agent action generators</h2><p>Each button sends one backend request, records source/model/fallback status, and never exposes prompts, keys, tokens, phone numbers, or secrets.</p><div class="sp-action-row">@foreach (var label in actions) { var value = label == "Run Live Gemini Test" ? "Live Gemini Connector Test" : label; <form method="post" action="/gemini-agent/generate"><input type="hidden" name="briefType" value="@value" /><button class="sp-btn sp-btn--outline">@label</button></form> }</div></section>

<section class="sp-grid sp-grid--2 sp-mt">
  <article class="sp-card"><h2>Gemini vs deterministic fallback</h2>@if (last == null) { <p>Generate any brief to compare deterministic recommendation with Gemini-enhanced reasoning.</p> } else { <p><strong>Deterministic recommendation:</strong> @last.DeterministicRecommendation</p><p><strong>Gemini-enhanced recommendation:</strong> @last.GeminiEnhancedRecommendation</p><p><strong>Differences:</strong> @last.Differences</p><p><strong>Confidence/caveat:</strong> Connector-ready demo using synthetic data; human approval gates every external action.</p><p><strong>Human approval status:</strong> @last.ApprovalStatus</p><p><strong>Audit event saved:</strong> @last.GeneratedAtUtc.ToString("u") for plan <a href="/execution/plans/@last.PlanId">@last.PlanId[..8]</a>.</p> }</article>
  <article class="sp-card"><h2>Governance shortcuts</h2><p>Agent safety checks block secret exfiltration, approval bypasses and autonomous production sends.</p><p><a class="sp-btn sp-btn--primary" href="/agent-governance">Open Agent Governance</a> <a class="sp-btn sp-btn--outline" href="/ops-ingest">Open Ops Ingest</a></p><p><a href="/enterprise-readiness">Enterprise readiness checklist</a> explains what is demo-ready, configured, connector-ready and still requires pilot credentials.</p></article>
</section>

<section class="sp-card sp-mt"><h2>Audit/history for this demo session</h2>@if (!history.Any()) { <p>No generated briefs yet. Generate one to create a session audit record.</p> } else { <div class="sp-table-wrap"><table class="sp-table"><thead><tr><th>Timestamp</th><th>Action type</th><th>Source model</th><th>Input signals used</th><th>Recommended action</th><th>Approval</th></tr></thead><tbody>@foreach (var item in history) { <tr><td>@item.GeneratedAtUtc.ToString("u")</td><td>@item.BriefType</td><td>@item.SourceModel</td><td>@item.InputSignalsUsed</td><td>@item.RecommendedAction</td><td>@item.ApprovalStatus</td></tr> }</tbody></table></div> }</section>
