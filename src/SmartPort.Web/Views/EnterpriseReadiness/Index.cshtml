        ("Agent guardrails", "Demo Ready", "Deterministic safety checks block secrets, approval bypasses and unsafe autonomous actions."),
        ("Gemini/fallback resilience", "Configured", "Gemini-enhanced when configured; local deterministic fallback always works."),
        ("Data source readiness", "Connector Ready", "Synthetic demo data today; IPMS/TOS/gate/fleet/GPS field mapping ready for approved pilots."),
        ("Webhook/API readiness", "Connector Ready", "Mobile API and WhatsApp webhook endpoints exist with token/verify-token checks."),
