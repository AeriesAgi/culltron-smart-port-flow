@model SmartPort.Application.Interfaces.AlertDto
@{
    var sevClass = Model.Severity switch {
        SmartPort.Domain.Enums.IncidentSeverity.Critical => "critical",
        SmartPort.Domain.Enums.IncidentSeverity.High     => "high",
        SmartPort.Domain.Enums.IncidentSeverity.Medium   => "medium",
        _                                                => "low"
    };
}
<div class="sp-alert-card sp-alert-card--@sevClass">
    <div class="sp-alert-card__severity-bar"></div>
    <div class="sp-alert-card__body">
        <div class="sp-alert-card__header">
            <div class="sp-alert-card__title">@Model.Title</div>
            <div class="sp-alert-card__meta">
                <span class="sp-badge sp-badge--type">@Model.AlertType</span>
                @if (!string.IsNullOrEmpty(Model.VesselName)) { <span>· @Model.VesselName</span> }
                <span>· @Model.CreatedAt.ToString("HH:mm dd MMM")</span>
                @if (Model.IsAutoGenerated) { <span class="sp-badge sp-badge--muted" style="font-size:10px">AUTO</span> }
            </div>
        </div>
        <p class="sp-alert-card__message">@Model.Message</p>
        @if (!string.IsNullOrEmpty(Model.AcknowledgedBy))
        { <div class="sp-alert-card__ack">Acknowledged by @Model.AcknowledgedBy at @Model.AcknowledgedAt?.ToString("HH:mm dd MMM")</div> }
    </div>
    @if (Model.Status == SmartPort.Domain.Enums.AlertStatus.Active &&
         (User.IsInRole("Admin") || User.IsInRole("PortOperationsManager") || User.IsInRole("TerminalStaff")))
    {
        <div class="sp-alert-card__actions">
            <form asp-controller="Incidents" asp-action="AcknowledgeAlert" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sp-btn sp-btn--sm sp-btn--outline">Acknowledge</button>
            </form>
        </div>
    }
</div>
