@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Error"; }
<div class="sp-auth-page">
    <div class="sp-auth-card sp-auth-card--error">
        <div class="sp-auth-card__header">
            <div style="font-size:3rem;margin-bottom:.5rem">⚠️</div>
            <h1>Something went wrong</h1>
            <p>An unexpected error occurred. Please try again or contact your system administrator.</p>
            <p><strong>Request ID:</strong> @Context.TraceIdentifier</p>
        </div>
        <div style="text-align:center;margin-top:1.5rem;display:flex;flex-direction:column;gap:.75rem">
            <a href="/dashboard" class="sp-btn sp-btn--primary">Back to Dashboard</a>
            <a href="/" class="sp-btn sp-btn--outline">Go to Home Page</a>
        </div>
    </div>
</div>
