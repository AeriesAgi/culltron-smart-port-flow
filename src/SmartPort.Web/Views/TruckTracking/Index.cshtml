@model TruckTrackingDashboardDto
@{
    ViewData["Title"] = "Truck Tracking & ETA Intelligence";
}

<section class="sp-tracking-hero sp-premium-panel">
    <div>
        <div class="sp-agent-badge"><span class="sp-live-dot"></span> Local ETA Intelligence · Synthetic Demo Data</div>
        <h1>Truck Tracking &amp; ETA Intelligence</h1>
        <p>Deterministic local view of active trucks approaching the port, queue exposure, idling risk, CO₂ impact and operator release actions.</p>
    </div>
    <div class="sp-gauge sp-gauge--cyan" style="--value:@Model.GatePressureScore">
        <div class="sp-gauge__ring"></div>
        <div class="sp-gauge__value">@Model.GatePressureScore</div>
        <div class="sp-gauge__label">Gate Pressure</div>
    </div>
</section>

<div class="sp-kpi-grid sp-kpi-grid--sm sp-kpi-grid--tracking">
    <div class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@Model.ActiveTrucks</div><div class="sp-kpi-card__label">Active Trucks</div><div class="sp-kpi-card__sub">Approaching port corridors</div></div></div>
    <div class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@Model.DelayedCount</div><div class="sp-kpi-card__label">Delayed Trucks</div><div class="sp-kpi-card__sub">Need dispatcher advice</div></div></div>
    <div class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@Model.HoldOutsidePortCount</div><div class="sp-kpi-card__label">Hold Outside Port</div><div class="sp-kpi-card__sub">Avoid live queue idling</div></div></div>
    <div class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@Model.PriorityReleaseCount</div><div class="sp-kpi-card__label">Priority Release</div><div class="sp-kpi-card__sub">Pre-cleared urgent cargo</div></div></div>
    <div class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@($"{Model.TotalIdlingMinutes:F0} min")</div><div class="sp-kpi-card__label">Queue Idling</div><div class="sp-kpi-card__sub">Estimated exposure</div></div></div>
    <div class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@($"{Model.EstimatedCo2Kg:F1} kg")</div><div class="sp-kpi-card__label">CO₂ Exposure</div><div class="sp-kpi-card__sub">Indicative estimate</div></div></div>
</div>

<div class="sp-tracking-grid">
    <div class="sp-card sp-card--span2">
        <div class="sp-card__header">
            <h3 class="sp-card__title">Active Truck ETA Board</h3>
            <span class="sp-card__meta">No GPS/API dependency · demo telemetry</span>
        </div>
        <div class="sp-truck-list">
            @foreach (var truck in Model.Trucks)
            {
                <article class="sp-truck-card sp-truck-card--@truck.StatusTone">
                    <div class="sp-truck-card__head">
                        <div>
                            <strong>@truck.FleetIdentifier</strong>
                            <span>@truck.OrganisationName · @truck.RouteCorridor</span>
                        </div>
                        <span class="sp-badge sp-badge--@truck.StatusTone">@truck.Status</span>
                    </div>
                    <div class="sp-truck-card__metrics">
                        <div><span>ETA</span><strong>@truck.EtaMinutesToGate min</strong></div>
                        <div><span>Checkpoint</span><strong>@truck.CurrentCheckpoint</strong></div>
                        <div><span>Queue</span><strong>@truck.QueueStatus</strong></div>
                        <div><span>Idling</span><strong>@($"{truck.IdlingMinutes:F0} min")</strong></div>
                        <div><span>CO₂</span><strong>@($"{truck.EstimatedCo2Kg:F1} kg")</strong></div>
                        <div><span>Risk</span><strong>@truck.DelayRiskScore/100</strong></div>
                    </div>
                    <div class="sp-route-timeline">
                        @foreach (var step in truck.Timeline)
                        {
                            <span class="@(step == truck.CurrentCheckpoint ? "active" : "")">@step</span>
                        }
                    </div>
                    <div class="sp-truck-action"><i data-feather="zap"></i> @truck.RecommendedAction</div>
                </article>
            }
        </div>
    </div>

    <aside class="sp-tracking-side">
        <div class="sp-card">
            <div class="sp-card__header"><h3 class="sp-card__title">Operator Focus</h3></div>
            <div class="sp-action-stack">
                <div class="sp-action-note"><strong>Hold outside port</strong><span>@string.Join(" · ", Model.Trucks.Where(t => t.Status == "Hold Outside Port").Take(3).Select(t => t.FleetIdentifier).DefaultIfEmpty("No holds above threshold"))</span></div>
                <div class="sp-action-note"><strong>Priority release</strong><span>@string.Join(" · ", Model.Trucks.Where(t => t.Status == "Priority Release").Take(3).Select(t => t.FleetIdentifier).DefaultIfEmpty("No priority release above threshold"))</span></div>
                <div class="sp-action-note"><strong>Reroute / advise dispatcher</strong><span>@string.Join(" · ", Model.Trucks.Where(t => t.Status is "Delayed" or "Queue Risk").Take(3).Select(t => t.FleetIdentifier).DefaultIfEmpty("No reroute advisory required"))</span></div>
                <div class="sp-action-note"><strong>@($"{Model.EstimatedCo2Kg:F1} kg CO₂")</strong><span>Use emissions view to quantify idling reduction opportunity.</span></div>
            </div>
        </div>
        <div class="sp-card sp-judge-card">
            <div class="sp-card__header"><h3 class="sp-card__title">Ask Copilot</h3></div>
            <p>Prompt the conversational interface without external map or AI APIs.</p>
            <div class="sp-copilot-mini-topics"><a class="sp-btn sp-btn--primary sp-btn--full" asp-controller="Copilot" asp-action="Index" asp-route-prompt="which trucks should be held outside the port">Hold trucks</a><a class="sp-btn sp-btn--outline sp-btn--full" asp-controller="Copilot" asp-action="Index" asp-route-prompt="track delayed trucks">Delayed trucks</a><a class="sp-btn sp-btn--outline sp-btn--full" asp-controller="Copilot" asp-action="Index" asp-route-prompt="priority release trucks">Priority release</a><a class="sp-btn sp-btn--outline sp-btn--full" asp-controller="Copilot" asp-action="Index" asp-route-prompt="truck ETA risks">ETA risks</a></div>
        </div>
    </aside>
</div>

