@{
    ViewData["Title"] = "Agent Governance";
    var examples = ViewBag.Examples as IReadOnlyList<string> ?? Array.Empty<string>();
    var history = ViewBag.History as IReadOnlyList<SmartPort.Web.Controllers.AgentSafetyAuditItem> ?? Array.Empty<SmartPort.Web.Controllers.AgentSafetyAuditItem>();
}
<section class="sp-page-hero"><div><span class="sp-badge">Agent Security & AI Governance</span><h1>Smart Port Agent Governance</h1><p>Deterministic guardrails demonstrate enterprise controls: human approval, secrets protection, role-based permissions, prompt-injection checks and audit trail before any fleet or driver action leaves the system.</p></div><a class="sp-btn sp-btn--primary" href="/gemini-agent">Back to Gemini Agent</a></section>

<div class="sp-grid sp-grid--3">
  <article class="sp-card"><h2>Policy guardrails</h2><ul class="sp-list"><li>No autonomous external sends in production mode.</li><li>No secrets, access tokens or API keys in prompts.</li><li>No customer data in demo; synthetic data only.</li><li>Prompt injection requests are treated as untrusted instructions.</li><li>Every agent action creates an audit/history record.</li></ul></article>
  <article class="sp-card"><h2>Allowed action types</h2><ul class="sp-list"><li>Generate operational summaries.</li><li>Draft fleet owner action plans.</li><li>Draft driver instructions.</li><li>Recommend staging/gate moves.</li><li>Estimate idling and CO₂ impact.</li></ul></article>
  <article class="sp-card"><h2>Blocked action types</h2><ul class="sp-list"><li>Bypass approval or release all trucks.</li><li>Expose WhatsApp/Gemini/database tokens.</li><li>Send messages to unapproved live numbers.</li><li>Claim live Transnet/IPMS integration.</li><li>Persist customer data in the demo.</li></ul></article>
</div>

<section class="sp-card sp-mt"><h2>Action approval matrix</h2><div class="sp-table-wrap"><table class="sp-table"><thead><tr><th>Action</th><th>Port Admin</th><th>Fleet Owner</th><th>Driver</th><th>Judge Demo</th><th>Control</th></tr></thead><tbody><tr><td>Generate plan/brief</td><td>Allowed</td><td>Allowed</td><td>Scoped</td><td>Allowed</td><td>Audit saved</td></tr><tr><td>Move truck to staging</td><td>Approve</td><td>Request/approve own fleet</td><td>Confirm arrival</td><td>Demo approve</td><td>Human approval required</td></tr><tr><td>Release to gate</td><td>Approve</td><td>Request</td><td>Proceed when instructed</td><td>Demo approve</td><td>No autonomous release</td></tr><tr><td>WhatsApp/mobile send</td><td>Approve configured pilot</td><td>Draft/approve own fleet</td><td>Receive/confirm</td><td>Simulated only</td><td>Credentials + consent required</td></tr><tr><td>Secret/token access</td><td>Blocked in UI</td><td>Blocked</td><td>Blocked</td><td>Blocked</td><td>Secret exfiltration blocked</td></tr></tbody></table></div></section>

<section class="sp-grid sp-grid--2 sp-mt"><article class="sp-card"><h2>Demo agent safety check</h2><form method="post" action="/agent-governance/check"><label for="requestText">Request to evaluate</label><textarea id="requestText" name="requestText" rows="4" class="sp-input">Generate fleet owner summary</textarea><button class="sp-btn sp-btn--primary" type="submit">Run safety check</button></form><h3>Try these examples</h3><div class="sp-action-row">@foreach (var example in examples) { <form method="post" action="/agent-governance/check"><input type="hidden" name="requestText" value="@example" /><button class="sp-btn sp-btn--outline">@example</button></form> }</div></article><article class="sp-card"><h2>Expected results</h2><ul class="sp-list"><li>Safe allowed action for summaries and analysis.</li><li>Human approval required for sends, releases and state changes.</li><li>Blocked unsafe request for approval bypass attempts.</li><li>Secret exfiltration blocked for tokens/API keys.</li><li>Audit entry created for every check.</li></ul></article></section>

<section class="sp-card sp-mt"><h2>Safety audit history</h2>@if (!history.Any()) { <p>No safety checks yet. Run an example to create an audit entry.</p> } else { <div class="sp-table-wrap"><table class="sp-table"><thead><tr><th>Time</th><th>Request</th><th>Decision</th><th>Category</th><th>Rationale</th><th>Approval</th></tr></thead><tbody>@foreach (var item in history) { <tr><td>@item.TimestampUtc.ToString("u")</td><td>@item.RequestText</td><td>@item.Decision</td><td>@item.Category</td><td>@item.Rationale</td><td>@item.ApprovalState</td></tr> }</tbody></table></div> }</section>
