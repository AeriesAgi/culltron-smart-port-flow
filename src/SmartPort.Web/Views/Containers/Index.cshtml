@model SmartPort.Application.Interfaces.PagedResult<SmartPort.Application.Interfaces.ContainerListDto>
@{
    ViewData["Title"] = "Container Tracking";
    var filter = ViewBag.Filter as SmartPort.Application.Interfaces.ContainerFilterDto ?? new();
}
<div class="sp-toolbar">
    <form method="get" class="sp-filter-bar">
        <input name="SearchTerm" value="@filter.SearchTerm" class="sp-form__input sp-form__input--sm" placeholder="Container number…" />
        <select name="Status" class="sp-form__select sp-form__select--sm">
            <option value="">All Status</option>
            @foreach (var s in Enum.GetValues<SmartPort.Domain.Enums.ContainerStatus>()) { <option value="@s" selected="@(filter.Status == s)">@s</option> }
        </select>
        <select name="Direction" class="sp-form__select sp-form__select--sm">
            <option value="">All Directions</option>
            @foreach (var d in Enum.GetValues<SmartPort.Domain.Enums.ContainerDirection>()) { <option value="@d" selected="@(filter.Direction == d)">@d</option> }
        </select>
        <select name="IsDwellAlert" class="sp-form__select sp-form__select--sm">
            <option value="">Dwell: All</option>
            <option value="true" selected="@(filter.IsDwellAlert == true)">Dwell Alerts Only</option>
        </select>
        <select name="IsOnHold" class="sp-form__select sp-form__select--sm">
            <option value="">Hold: All</option>
            <option value="true" selected="@(filter.IsOnHold == true)">On Hold Only</option>
        </select>
        <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary">Filter</button>
        <a asp-action="Index" class="sp-btn sp-btn--sm sp-btn--outline">Reset</a>
    </form>
    <div class="sp-toolbar__actions">
        <a asp-action="Track" class="sp-btn sp-btn--sm sp-btn--outline">Track Container</a>
        <a asp-action="Yard" class="sp-btn sp-btn--sm sp-btn--outline">Yard View</a>
        <a asp-action="DwellAlerts" class="sp-btn sp-btn--sm sp-btn--warning">Dwell Alerts</a>
    </div>
</div>
<div class="sp-card">
    <table class="sp-table">
        <thead><tr><th>Container No.</th><th>Size / Type</th><th>Direction</th><th>Status</th><th>Yard Slot</th><th>Dwell</th><th>Customs</th><th>Flags</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model.Items)
            {
                var dirClass = c.Direction switch {
                    SmartPort.Domain.Enums.ContainerDirection.Import => "blue",
                    SmartPort.Domain.Enums.ContainerDirection.Export => "green",
                    _ => "muted"
                };
                var csClass = c.CustomsStatus switch {
                    SmartPort.Domain.Enums.ComplianceStatus.Compliant => "success",
                    SmartPort.Domain.Enums.ComplianceStatus.NonCompliant => "danger",
                    SmartPort.Domain.Enums.ComplianceStatus.PendingReview => "warning",
                    _ => "muted"
                };
                <tr class="@(c.IsDwellAlertRaised ? "sp-table__row--warn" : c.IsOnHold ? "sp-table__row--danger" : "")">
                    <td>
                        <div class="sp-table__primary sp-table__mono"><a asp-action="Detail" asp-route-id="@c.Id">@c.ContainerNumber</a></div>
                        <div class="sp-table__secondary">@c.ShippingLine · @c.VesselName</div>
                    </td>
                    <td><span class="sp-badge sp-badge--type">@((int)c.Size)ft</span> @c.ContainerType</td>
                    <td><span class="sp-badge sp-badge--@dirClass">@c.Direction</span></td>
                    <td><span class="sp-badge sp-badge--info">@c.Status</span></td>
                    <td class="sp-table__mono">@(c.YardBlockCode != null ? $"Blk {c.YardBlockCode} · {c.YardSlot}" : "—")</td>
                    <td class="@(c.IsDwellAlertRaised ? "sp-table__cell--danger" : "")">@(c.DwellTimeHours.HasValue ? $"{c.DwellTimeHours:F0}h" : "—")</td>
                    <td><span class="sp-badge sp-badge--@csClass">@c.CustomsStatus</span></td>
                    <td>
                        @if (c.IsHazardous) { <span class="sp-badge sp-badge--danger">HAZ</span> }
                        @if (c.IsReefer)    { <span class="sp-badge sp-badge--info">REF</span> }
                        @if (c.IsOnHold)    { <span class="sp-badge sp-badge--warning">HOLD</span> }
                        @if (c.IsDwellAlertRaised) { <span class="sp-badge sp-badge--warning">DWELL</span> }
                    </td>
                    <td><a asp-action="Detail" asp-route-id="@c.Id" class="sp-btn sp-btn--xs sp-btn--outline">View</a></td>
                </tr>
            }
            @if (!Model.Items.Any())
            { <tr><td colspan="9" class="sp-table__empty">No containers match the current filter.</td></tr> }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model)
</div>
