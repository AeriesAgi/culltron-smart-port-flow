@model CopilotChatPageModel
@{
    ViewData["Title"] = "Copilot Chat";
    var ctx = Model.Context;
    var response = Model.Response;
}

<section class="sp-copilot-shell">
    <div class="sp-copilot-hero">
        <div>
            <div class="sp-agent-badge"><span>✦</span> Local SmartPort Copilot Chat</div>
            <h1>Ask the port. Get an action plan.</h1>
            <p>Deterministic, explainable operator assistance for congestion, berth pressure, gate queues, truck idling, load-shedding, emissions and decision audit — with no external AI APIs.</p>
        </div>
        <div class="sp-copilot-orb" aria-hidden="true"><span></span></div>
    </div>

    <div class="sp-copilot-metrics">
        <div><span>Gate Queue</span><strong>@ctx.TrucksInQueue</strong><small>trucks</small></div>
        <div><span>Berth Util.</span><strong>@($"{ctx.BerthUtilisationPct:F0}%")</strong><small>@ctx.BerthsOccupied occupied</small></div>
        <div><span>Yard Pressure</span><strong>@($"{ctx.YardOccupancyPct:F1}%")</strong><small>@ctx.DwellAlerts dwell alerts</small></div>
        <div><span>CO₂ Today</span><strong>@($"{ctx.EstimatedCo2Today:F1} kg")</strong><small>@($"{ctx.TotalIdlingMinutesToday:F0} idle min")</small></div>
        <div><span>Energy</span><strong>@(ctx.LoadSheddingActive ? "ACTIVE" : "STABLE")</strong><small>@ctx.ActiveDisruptions disruptions</small></div>
    </div>

    <div class="sp-copilot-grid">
        <div class="sp-copilot-chat-card">
            <div class="sp-copilot-chat-card__header">
                <div>
                    <span class="sp-copilot-status-dot"></span>
                    <strong>SmartPort Copilot</strong>
                    <small>Local deterministic rules/scoring engine · scope-controlled assistant</small>
                </div>
                <div style="display:flex;gap:.4rem;flex-wrap:wrap;justify-content:flex-end">
                    <span class="sp-badge sp-badge--info">Offline-safe</span>
                    <span class="sp-badge sp-badge--success">Demo data</span>
                </div>
            </div>

            <div class="sp-copilot-thread" id="copilotThread">
                <div class="sp-copilot-message sp-copilot-message--assistant">
                    <div class="sp-copilot-avatar">AI</div>
                    <div class="sp-copilot-bubble">
                        <strong>Ready for shift command.</strong>
                        <p>Ask about truck tracking/ETA, risks, gates, berths, yard congestion, load-shedding, emissions, scenarios or demo narration. I will respond with summary, reasoning, action, expected impact, confidence and links.</p>
                    </div>
                </div>

                @if (response != null)
                {
                    <div class="sp-copilot-message sp-copilot-message--user">
                        <div class="sp-copilot-bubble">@response.Prompt</div>
                        <div class="sp-copilot-avatar">OP</div>
                    </div>
                    <div class="sp-copilot-message sp-copilot-message--assistant sp-copilot-message--answer">
                        <div class="sp-copilot-avatar">AI</div>
                        <div class="sp-copilot-bubble sp-copilot-bubble--rich">
                            <div class="sp-copilot-answer-head">
                                <div>
                                    <div class="sp-copilot-answer-intent">@response.Intent.ToUpperInvariant()</div>
                                    <h2>@response.Summary</h2>
                                </div>
                                <div class="sp-copilot-confidence"><span>@response.ConfidenceScore%</span><small>confidence</small></div>
                            </div>

                            <div class="sp-copilot-badges">
                                @foreach (var badge in response.MetricBadges)
                                {
                                    <span class="sp-copilot-badge sp-copilot-badge--@badge.Tone"><b>@badge.Label</b>@badge.Value</span>
                                }
                            </div>

                            <div class="sp-copilot-response-grid">
                                <section><h3>Operational reasoning</h3><p>@response.OperationalReasoning</p></section>
                                <section><h3>Recommended action</h3><p>@response.RecommendedAction</p></section>
                                <section><h3>Expected impact</h3><p>@response.ExpectedImpact</p></section>
                                <section><h3>Emissions / idling impact</h3><p>@response.EmissionsImpact</p></section>
                                <section><h3>Energy impact</h3><p>@response.EnergyImpact</p></section>
                            </div>

                            <div class="sp-copilot-action-row">
                                @foreach (var action in response.ActionCards)
                                {
                                    <a href="@action.Url" class="sp-copilot-action-card">
                                        <span>@action.Icon</span>
                                        <strong>@action.Title</strong>
                                        <small>@action.Description</small>
                                    </a>
                                }
                            </div>

                            <div class="sp-copilot-timestamp">Generated @response.GeneratedAt.ToString("HH:mm:ss") UTC · Synthetic demo data</div>
                        </div>
                    </div>
                }

                <div class="sp-copilot-typing" id="copilotTyping" hidden>
                    <span></span><span></span><span></span>
                    <em>Analysing live demo context locally…</em>
                </div>
            </div>

            <form asp-action="Ask" asp-controller="Copilot" method="post" class="sp-copilot-form" id="copilotForm">
                @Html.AntiForgeryToken()
                <input name="prompt" class="sp-copilot-input" value="@Model.CurrentPrompt" placeholder="Ask: What is the biggest risk right now?" autocomplete="off" />
                <button type="submit" class="sp-btn sp-btn--primary">Send Command</button>
            </form>
        </div>

        <aside class="sp-copilot-side">
            <div class="sp-card sp-supported-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Supported Topics</h3></div>
                <div class="sp-supported-topics">
                    @foreach (var topic in Model.SupportedTopics)
                    {
                        <span>@topic</span>
                    }
                </div>
                <p class="sp-scope-note">Scope-limited to smart port flow, disruption, emissions, tracking, scenarios and recommendations. Unsafe or unrelated requests are redirected.</p>
            </div>

            <div class="sp-card sp-judge-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Judge Demo Path</h3></div>
                <p>Landing → Dashboard → AI Agent → Copilot Chat → Truck Tracking → Scenario Simulator → Emissions → Recommendations</p>
            </div>

            <div class="sp-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Demo Prompt Chips</h3></div>
                <div class="sp-copilot-chip-grid">
                    @foreach (var chip in Model.PromptChips)
                    {
                        <form asp-action="Ask" asp-controller="Copilot" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="prompt" value="@chip.Prompt" />
                            <button type="submit" class="sp-copilot-chip"><span>@chip.Icon</span><strong>@chip.Label</strong><small>@chip.Prompt</small></button>
                        </form>
                    }
                </div>
            </div>

            <div class="sp-card sp-copilot-brief-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Shift Brief Snapshot</h3></div>
                <ul>
                    <li><span>Vessels in port</span><strong>@ctx.VesselsInPort</strong></li>
                    <li><span>At anchor</span><strong>@ctx.VesselsAtAnchor</strong></li>
                    <li><span>Open incidents</span><strong>@ctx.OpenIncidents</strong></li>
                    <li><span>High-risk trips</span><strong>@ctx.HighRiskTrips</strong></li>
                    <li><span>Active alerts</span><strong>@ctx.ActiveAlerts</strong></li>
                </ul>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
<script>
(function () {
  const form = document.getElementById('copilotForm');
  const typing = document.getElementById('copilotTyping');
  if (form && typing) {
    form.addEventListener('submit', function () {
      typing.hidden = false;
      typing.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
})();
</script>
}
