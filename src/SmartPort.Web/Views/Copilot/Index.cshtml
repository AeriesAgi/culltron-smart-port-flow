@model CopilotChatPageModel
@{
    ViewData["Title"] = "SmartPort Copilot Chat";
    var ctx = Model.Context;
    var initialPrompt = Model.CurrentPrompt ?? string.Empty;
}

<section class="sp-copilot-shell">
    <div class="sp-copilot-hero">
        <div>
            <div class="sp-agent-badge"><span class="sp-live-dot"></span> SmartPort Copilot — Local deterministic operations assistant</div>
            <h1>SmartPort Copilot Chat</h1>
            <p>Conversational assistant for scoped smart-port questions. AJAX-powered, scope-limited operator assistance for truck ETA, gate queues, berth pressure, yard congestion, emissions, load-shedding, scenarios and decision audit — with no external AI APIs.</p>
        </div>
        <div class="sp-copilot-orb" aria-hidden="true"><span></span></div>
    </div>

    <div class="sp-copilot-metrics">
        <div><span>Gate Queue</span><strong>@ctx.TrucksInQueue</strong><small>trucks</small></div>
        <div><span>Berth Util.</span><strong>@($"{ctx.BerthUtilisationPct:F0}%")</strong><small>@ctx.BerthsOccupied occupied</small></div>
        <div><span>Yard Pressure</span><strong>@($"{ctx.YardOccupancyPct:F1}%")</strong><small>@ctx.DwellAlerts dwell alerts</small></div>
        <div><span>CO₂ Today</span><strong>@($"{ctx.EstimatedCo2Today:F1} kg")</strong><small>@($"{ctx.TotalIdlingMinutesToday:F0} idle min")</small></div>
        <div><span>Energy</span><strong>@(ctx.LoadSheddingActive ? "ACTIVE" : "STABLE")</strong><small>@ctx.ActiveDisruptions disruptions</small></div>
    </div>

    <div class="sp-copilot-grid">
        <div class="sp-copilot-chat-card">
            <div class="sp-copilot-chat-card__header">
                <div>
                    <span class="sp-copilot-status-dot"></span>
                    <strong>SmartPort Copilot</strong>
                    <small>Local deterministic operations assistant</small>
                </div>
                <div class="sp-copilot-header-badges">
                    <span class="sp-badge sp-badge--info">Offline-safe</span>
                    <span class="sp-badge sp-badge--success">Synthetic demo data</span>
                    <span class="sp-badge sp-badge--warning">Scope-limited</span>
                    <span class="sp-badge sp-badge--ai">No external AI API</span>
                </div>
            </div>

            <div class="sp-copilot-thread" id="copilotThread" aria-live="polite">
                <div class="sp-copilot-message sp-copilot-message--assistant sp-copilot-welcome" data-static="true">
                    <div class="sp-copilot-avatar">AI</div>
                    <div class="sp-copilot-bubble">
                        <strong>Running locally and ready for port operations.</strong>
                        <p>I can help with truck queues, ETA tracking, gate bottlenecks, berth pressure, yard congestion, emissions, load-shedding disruption, scenario simulation and operator action plans.</p>
                    </div>
                </div>

                <div class="sp-copilot-typing" id="copilotTyping" hidden>
                    <span></span><span></span><span></span>
                    <em id="copilotTypingText">Scoring synthetic port state locally…</em>
                </div>
            </div>

            <form asp-action="AskJson" asp-controller="Copilot" method="post" class="sp-copilot-form" id="copilotForm" data-initial-prompt="@initialPrompt">
                @Html.AntiForgeryToken()
                <textarea name="prompt" class="sp-copilot-input sp-copilot-textarea" id="copilotInput" rows="2" placeholder="Command: ask about truck ETA, gate queue, berth pressure, CO₂ savings or an operator action plan…" autocomplete="off"></textarea>
                <div class="sp-copilot-compose-actions">
                    <button type="submit" class="sp-btn sp-btn--primary" id="copilotSend">Send Command</button>
                    <button type="button" class="sp-btn sp-btn--outline" id="copilotClear">Clear</button>
                </div>
            </form>
        </div>

        <aside class="sp-copilot-side">
            <div class="sp-card sp-supported-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Supported Topics</h3></div>
                <div class="sp-supported-topics sp-supported-topics--clickable">
                    @foreach (var topic in Model.SupportedTopics)
                    {
                        <button type="button" data-topic="@topic">@topic</button>
                    }
                </div>
                <p class="sp-scope-note">Scope-limited to smart port flow, disruption, emissions, tracking, scenarios and recommendations. Unsafe or unrelated requests are redirected.</p>
            </div>

            <div class="sp-card sp-judge-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Judge Demo Path</h3></div>
                <p>Landing → Dashboard → AI Command Centre → SmartPort Copilot Chat → Truck Tracking → Scenario Simulator → Emissions → Recommendations</p>
            </div>

            <div class="sp-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Demo Prompt Chips</h3></div>
                <div class="sp-copilot-chip-grid">
                    @foreach (var chip in Model.PromptChips)
                    {
                        <button type="button" class="sp-copilot-chip" data-prompt="@chip.Prompt"><span>@chip.Icon</span><strong>@chip.Label</strong><small>@chip.Prompt</small></button>
                    }
                </div>
            </div>

            <div class="sp-card sp-copilot-brief-card">
                <div class="sp-card__header"><h3 class="sp-card__title">Shift Brief Snapshot</h3></div>
                <ul>
                    <li><span>Vessels in port</span><strong>@ctx.VesselsInPort</strong></li>
                    <li><span>At anchor</span><strong>@ctx.VesselsAtAnchor</strong></li>
                    <li><span>Open incidents</span><strong>@ctx.OpenIncidents</strong></li>
                    <li><span>High-risk trips</span><strong>@ctx.HighRiskTrips</strong></li>
                    <li><span>Active alerts</span><strong>@ctx.ActiveAlerts</strong></li>
                </ul>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
<script>
(function () {
  const form = document.getElementById('copilotForm');
  const input = document.getElementById('copilotInput');
  const thread = document.getElementById('copilotThread');
  const typing = document.getElementById('copilotTyping');
  const typingText = document.getElementById('copilotTypingText');
  const clearBtn = document.getElementById('copilotClear');
  const sendBtn = document.getElementById('copilotSend');
  const token = form?.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
  const storageKey = 'smartport.copilot.chat.v2';
  const topicPrompts = {
    'Truck queues': 'trucks on queue',
    'Truck tracking / ETA': 'which trucks should be held outside the port',
    'Gate bottlenecks': 'Which gate is becoming a bottleneck?',
    'Berth pressure': 'Which berth needs attention?',
    'Yard congestion': 'Explain yard congestion risk.',
    'Emissions / CO₂': 'How much CO2 can we save?',
    'Load-shedding disruption': 'What happens if load-shedding starts soon?',
    'Scenario simulation': 'What scenario should operators run?',
    'Recommendations': 'Generate an operator action plan.',
    'Demo summary': 'Prepare a 2-minute demo summary.'
  };
  const thinkingPhrases = [
    'Scoring synthetic port state locally…',
    'Checking truck ETA, gate pressure, and emissions…',
    'Routing the request through deterministic Copilot intents…',
    'Preparing an explainable operator action…'
  ];
  let phraseTimer = null;
  let history = loadHistory();

  function loadHistory() {
    try { return JSON.parse(sessionStorage.getItem(storageKey) || '[]'); } catch { return []; }
  }
  function saveHistory() { sessionStorage.setItem(storageKey, JSON.stringify(history.slice(-16))); }
  function scrollLatest() { thread?.scrollTo({ top: thread.scrollHeight, behavior: 'smooth' }); }
  function escapeHtml(value) {
    return String(value || '').replace(/[&<>'"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[ch]));
  }
  function setBusy(isBusy) {
    if (!typing || !sendBtn || !input) return;
    typing.hidden = !isBusy;
    sendBtn.disabled = isBusy;
    input.disabled = isBusy;
    if (isBusy) {
      let i = 0;
      typingText.textContent = thinkingPhrases[0];
      phraseTimer = setInterval(() => { i = (i + 1) % thinkingPhrases.length; typingText.textContent = thinkingPhrases[i]; }, 1300);
      scrollLatest();
    } else {
      clearInterval(phraseTimer);
      phraseTimer = null;
    }
  }
  function removeDynamicMessages() {
    thread.querySelectorAll('.sp-copilot-message:not([data-static="true"])').forEach(el => el.remove());
  }
  function renderHistory() {
    removeDynamicMessages();
    history.forEach(item => {
      if (item.role === 'user') appendUser(item.text, false);
      if (item.role === 'assistant') appendAssistant(item.payload, false);
    });
    scrollLatest();
  }
  function appendUser(text, persist = true) {
    const el = document.createElement('div');
    el.className = 'sp-copilot-message sp-copilot-message--user';
    el.innerHTML = `<div class="sp-copilot-bubble">${escapeHtml(text)}</div><div class="sp-copilot-avatar">OP</div>`;
    thread.insertBefore(el, typing);
    if (persist) { history.push({ role: 'user', text }); saveHistory(); }
    scrollLatest();
  }
  function appendAssistant(data, persist = true) {
    const el = document.createElement('div');
    const isCompact = data.isSmallTalk || data.isOutOfScope || data.isVagueButRelated;
    const toneClass = data.isOutOfScope ? 'sp-copilot-bubble--warning' : data.isVagueButRelated ? 'sp-copilot-bubble--clarify' : '';
    el.className = 'sp-copilot-message sp-copilot-message--assistant sp-copilot-message--answer';
    el.innerHTML = isCompact ? compactAssistantHtml(data, toneClass) : detailedAssistantHtml(data);
    thread.insertBefore(el, typing);
    if (persist) { history.push({ role: 'assistant', payload: data }); saveHistory(); }
    if (typeof feather !== 'undefined') feather.replace({ width: 16, height: 16 });
    scrollLatest();
  }
  function compactAssistantHtml(data, toneClass) {
    return `<div class="sp-copilot-avatar">AI</div><div class="sp-copilot-bubble ${toneClass}">
      <strong>${escapeHtml(data.title || data.summary)}</strong>
      <p>${escapeHtml(data.shortAnswer || data.operationalReasoning || data.recommendedAction)}</p>
      <div class="sp-copilot-mini-topics">${((data.topicChips && data.topicChips.length) ? data.topicChips : Object.entries(topicPrompts).slice(0, 6).map(([label, prompt]) => ({ label, prompt }))).map(c => `<button type="button" data-prompt="${escapeHtml(c.prompt)}">${escapeHtml(c.label)}</button>`).join('')}</div>
    </div>`;
  }
  function detailedAssistantHtml(data) {
    const links = (data.actionLinks || []).map(a => `<a href="${escapeHtml(a.url)}" class="sp-copilot-action-card"><span>${escapeHtml(a.icon)}</span><strong>${escapeHtml(a.title)}</strong><small>${escapeHtml(a.description)}</small></a>`).join('');
    const badges = (data.metricBadges || [
      { label: 'Urgency', value: data.urgency, tone: urgencyTone(data.urgency) },
      { label: 'Confidence', value: `${data.confidence}%`, tone: 'success' },
      { label: 'Area', value: data.affectedArea, tone: 'teal' },
      { label: 'Intent', value: data.intent, tone: 'muted' }
    ]).map(b => `<span class="sp-copilot-badge sp-copilot-badge--${escapeHtml(b.tone)}"><b>${escapeHtml(b.label)}</b>${escapeHtml(b.value)}</span>`).join('');
    return `<div class="sp-copilot-avatar">AI</div><div class="sp-copilot-bubble sp-copilot-bubble--rich">
      <div class="sp-copilot-answer-head"><div><div class="sp-copilot-answer-intent">${escapeHtml(String(data.intent).toUpperCase())}</div><h2>${escapeHtml(data.summary)}</h2></div><div class="sp-copilot-confidence"><span>${escapeHtml(data.confidence)}%</span><small>confidence</small></div></div>
      <div class="sp-copilot-badges">${badges}</div>
      <div class="sp-copilot-response-grid">
        <section><h3>Operational reasoning</h3><p>${escapeHtml(data.operationalReasoning)}</p></section>
        <section><h3>Recommended action</h3><p>${escapeHtml(data.recommendedAction)}</p></section>
        <section><h3>Expected impact</h3><p>${escapeHtml(data.expectedImpact)}</p></section>
        <section><h3>Emissions / idling impact</h3><p>${escapeHtml(data.emissionsImpact)}</p></section>
        <section><h3>Energy impact</h3><p>${escapeHtml(data.energyImpact)}</p></section>
      </div>
      <div class="sp-copilot-action-row">${links}</div>
      <div class="sp-copilot-mini-topics">${(data.suggestedFollowUps || []).map(p => `<button type="button" data-prompt="${escapeHtml(p)}">${escapeHtml(p)}</button>`).join('')}</div>
      <div class="sp-copilot-timestamp">Generated ${escapeHtml(data.generatedAt)} UTC · ${escapeHtml(data.dataNote || 'Synthetic demo data · Local deterministic response')}</div>
    </div>`;
  }
  function urgencyTone(urgency) {
    const u = String(urgency || '').toLowerCase();
    return u === 'critical' ? 'danger' : u === 'high' ? 'warning' : 'info';
  }
  async function sendPrompt(prompt) {
    const text = (prompt || input.value || '').trim();
    if (!text) return;
    appendUser(text);
    input.value = '';
    setBusy(true);
    try {
      const body = new URLSearchParams();
      body.set('prompt', text);
      body.set('__RequestVerificationToken', token);
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body
      });
      if (!res.ok) throw new Error(`Copilot returned ${res.status}`);
      appendAssistant(await res.json());
    } catch (err) {
      appendAssistant({
        summary: 'Copilot stayed local but could not complete that request.',
        intent: 'local fallback', urgency: 'Low', confidence: 100, affectedArea: 'Copilot UX',
        operationalReasoning: 'The AJAX request failed or was interrupted; no external AI service was called.',
        recommendedAction: 'Try again, or open a supported topic chip such as truck tracking, gate bottleneck or emissions.',
        expectedImpact: 'Keeps the demo safe and avoids a broken page state.', emissionsImpact: 'No operational estimate changed.', energyImpact: 'No live systems were queried.',
        actionLinks: [{ title: 'Refresh Copilot', description: 'Reload the local chat page.', url: '/Copilot', icon: '↻' }], generatedAt: new Date().toLocaleTimeString(), isOutOfScope: true, isSmallTalk: false, isVagueButRelated: false
      });
    } finally {
      setBusy(false);
      input.disabled = false;
      input.focus();
      scrollLatest();
    }
  }

  renderHistory();
  form?.addEventListener('submit', e => { e.preventDefault(); sendPrompt(); });
  input?.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendPrompt(); } });
  clearBtn?.addEventListener('click', () => { history = []; saveHistory(); renderHistory(); input.value = ''; input.focus(); });
  document.addEventListener('click', e => {
    const promptButton = e.target.closest('[data-prompt]');
    if (promptButton) { e.preventDefault(); sendPrompt(promptButton.getAttribute('data-prompt')); }
    const topicButton = e.target.closest('[data-topic]');
    if (topicButton) { e.preventDefault(); sendPrompt(topicPrompts[topicButton.getAttribute('data-topic')] || topicButton.textContent); }
  });
  const initialPrompt = form?.getAttribute('data-initial-prompt') || '';
  if (initialPrompt && !history.some(x => x.role === 'user' && x.text.toLowerCase() === initialPrompt.toLowerCase())) {
    setTimeout(() => {
      sendPrompt(initialPrompt);
      if (window.history?.replaceState) window.history.replaceState({}, document.title, '/Copilot');
    }, 250);
  } else if (initialPrompt && window.history?.replaceState) {
    window.history.replaceState({}, document.title, '/Copilot');
  }
  input?.focus();
})();
</script>
}
