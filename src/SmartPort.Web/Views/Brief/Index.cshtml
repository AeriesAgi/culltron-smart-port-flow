@{
    ViewData["Title"] = "Executive Brief";
    var snapshot = ViewBag.Snapshot as SmartPortOperationsSnapshot;
    var trucks = ViewBag.Trucks as TruckTrackingDashboardDto;
}
<section class="sp-business-hero sp-premium-panel sp-print-hide"><div><div class="sp-agent-badge"><span class="sp-live-dot"></span> Hybrid shift report</div><h1>Smart Port Shift Brief</h1><p>Print-friendly executive and operator handover generated from synthetic demo data with Gemini/local fallback support.</p><div class="sp-command-actions"><button type="button" class="sp-btn sp-btn--primary" onclick="window.print()">Print / Save as PDF</button><button type="button" class="sp-btn sp-btn--outline" data-copy-brief>Copy brief</button><a class="sp-btn sp-btn--outline" asp-controller="Copilot" asp-action="Index" asp-route-prompt="generate executive brief">Open Copilot</a><a class="sp-btn sp-btn--outline" asp-controller="Impact" asp-action="Index">Impact Centre</a><a class="sp-btn sp-btn--outline" asp-controller="TruckTracking" asp-action="Index">Truck Tracking</a><a class="sp-btn sp-btn--outline" asp-controller="Flow" asp-action="Recommendations">Recommendations</a></div></div></section>
<article class="sp-brief sp-card" id="shiftBriefText">
    <header><h1>Culltron Smart Port Flow — Executive Shift Brief</h1><p>@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC · Synthetic demo data · Gemini/local fallback intelligence</p></header>
    <section><h2>Top operational risk</h2><p><strong>@snapshot?.TopRiskSeverity:</strong> @snapshot?.TopRisk</p><p>@snapshot?.TopRiskReason</p></section>
    <section class="sp-brief-grid"><div><span>Port flow status</span><strong>@snapshot?.VesselsInPort vessels · @snapshot?.BerthUtilisation.ToString("F0")% berth</strong></div><div><span>Truck queue status</span><strong>@snapshot?.TrucksInQueue queued · @trucks?.HoldOutsidePortCount hold candidates</strong></div><div><span>Gate/yard pressure</span><strong>@snapshot?.TopGateBottleneck · @snapshot?.YardOccupancy.ToString("F1")% yard</strong></div><div><span>Emissions/idling estimate</span><strong>@snapshot?.IdlingMinutes.ToString("F0") min · @snapshot?.EmissionsIdlingEstimateKg.ToString("F1") kg CO₂</strong></div><div><span>Energy risk</span><strong>@snapshot?.LoadSheddingEnergyRisk</strong></div><div><span>Expected impact</span><strong>@snapshot?.ExpectedConsequence</strong></div></section>
    <section><h2>Delayed / held trucks</h2><ul>@foreach (var item in snapshot?.DelayedTrucks ?? new List<string>()){<li>@item</li>}</ul></section>
    <section><h2>Recommended action plan</h2><ol>@foreach (var item in snapshot?.RecommendedActions ?? new List<string>()){<li>@item</li>}</ol></section>
    <section><h2>Integration readiness note</h2><p>Demo mode uses synthetic data. Production integrations would connect to GPS/telematics, TOS/IPMS, gate systems, energy data and emissions factors through prepared adapters that are disabled/demo-backed by default.</p></section>
    <footer><p>Disclaimer: Indicative demo calculations only. No live port integration, external GPS feed, automatic operational execution or verified emissions outcome is claimed.</p></footer>
</article>
@section Scripts { <script>document.querySelector('[data-copy-brief]')?.addEventListener('click', async()=>{await navigator.clipboard.writeText(document.getElementById('shiftBriefText')?.innerText||'');});</script> }
