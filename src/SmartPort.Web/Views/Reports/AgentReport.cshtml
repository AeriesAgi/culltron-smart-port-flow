@model SmartPort.Infrastructure.Services.OperationalReportResult
@using SmartPort.Infrastructure.Services
@{
    ViewData["Title"] = Model.Title;
}
<section class="sp-command-hero sp-premium-panel print-friendly-report">
    <div>
        <div class="sp-agent-badge"><span class="sp-live-dot"></span> Agent Report · @(Model.UsedGemini ? "Gemini enhanced" : "Local fallback")</div>
        <h1>@Model.Title</h1>
        <p>@Model.SafetyNote</p>
        <div class="sp-command-actions no-print">
            <button class="sp-btn sp-btn--primary" type="button" data-copy-report>Copy report</button>
            <button class="sp-btn sp-btn--outline" type="button" onclick="window.print()">Print</button>
            <form asp-action="DownloadAgentReport" asp-controller="Reports" method="post" style="display:inline-flex">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reportType" value="@Model.ReportType" />
                <input type="hidden" name="mode" value="@Model.GeneratedBy" />
                <button class="sp-btn sp-btn--outline" type="submit">Download Markdown</button>
            </form>
            <a class="sp-btn sp-btn--outline" asp-controller="Reports" asp-action="Index">Back to Reports</a>
        </div>
    </div>
    <div class="sp-command-hazard-dial sp-command-hazard-dial--@(Model.UsedGemini ? "high" : "medium")">
        <span>@Model.GeneratedBy</span>
        <strong>@(Model.FallbackActive ? "Fallback" : "Ready")</strong>
        <small>@Model.GeminiStatus</small>
    </div>
</section>

<section class="sp-business-grid sp-business-grid--compact">
    <article class="sp-business-card"><span>Generated by</span><strong>@Model.GeneratedBy</strong><small>@(Model.FallbackActive ? "Fallback active" : "Primary path")</small></article>
    <article class="sp-business-card"><span>Timestamp</span><strong>@Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</strong><small>Audit-friendly output</small></article>
    <article class="sp-business-card"><span>Input context</span><strong>Sanitized summary</strong><small>@Model.InputContextSummary</small></article>
    <article class="sp-business-card"><span>Execution</span><strong>Not automatic</strong><small>Human approval required</small></article>
</section>

<section id="agentReportText" class="sp-report-sections" style="display:grid;gap:1rem;margin-top:1.25rem">
    @foreach (var reportSection in Model.Sections)
    {
        <article class="sp-card sp-report-section sp-report-section--@(reportSection.Tone)" style="padding:1.25rem">
            <div class="sp-card__header"><h3 class="sp-card__title">@reportSection.Heading</h3><span class="sp-badge sp-badge--@(reportSection.Tone)">@(reportSection.Tone)</span></div>
            @if (!string.IsNullOrWhiteSpace(reportSection.Body))
            {
                <div class="sp-report-body" style="white-space:pre-wrap;color:var(--sp-text-muted);line-height:1.65">@reportSection.Body</div>
            }
            @if (reportSection.Bullets.Any())
            {
                <ul style="color:var(--sp-text-muted);line-height:1.7">
                    @foreach (var bullet in reportSection.Bullets)
                    {
                        <li>@bullet</li>
                    }
                </ul>
            }
        </article>
    }
</section>
<textarea id="agentReportMarkdown" class="no-print" style="position:absolute;left:-9999px">@Model.Markdown</textarea>

@section Scripts {
<script>
(() => {
  const btn = document.querySelector('[data-copy-report]');
  const text = document.getElementById('agentReportMarkdown');
  btn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(text?.value || '');
    btn.textContent = 'Copied';
    setTimeout(() => btn.textContent = 'Copy report', 1400);
  });
})();
</script>
}
