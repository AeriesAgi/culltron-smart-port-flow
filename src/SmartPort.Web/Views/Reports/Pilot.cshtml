@using SmartPort.Application.Interfaces
@{ ViewData["Title"] = "Pilot Summary Report"; var comp = ViewBag.Comparison as PilotComparisonResult; }
<div class="sp-toolbar"><h2 style="margin:0">Pilot Summary Report — @DateTime.UtcNow.ToString("dd MMM yyyy")</h2><a asp-action="Index" asp-controller="Reports" class="sp-btn sp-btn--sm sp-btn--outline">← Reports</a></div>
<div class="sp-alert sp-alert--info" style="margin-bottom:1rem"><i data-feather="info"></i> Synthetic pilot data for demonstration. No real operational data is used.</div>
@if (comp != null)
{
    <div class="sp-card" style="margin-bottom:1.25rem">
        <div class="sp-card__header"><h3 class="sp-card__title">Performance Summary</h3></div>
        <table class="sp-table">
            <thead><tr><th>Metric</th><th>Baseline</th><th>Current</th><th>Change</th></tr></thead>
            <tbody>
                <tr><td>Avg Waiting Time</td><td>@(comp.Baseline != null ? $"{comp.Baseline.AverageWaitingMinutes:F0} min" : "—")</td><td>@($"{comp.Current.AverageWaitingMinutes:F0} min")</td><td class="@(comp.WaitingMinutesChangePercent < 0 ? "sp-text-success" : "sp-text-danger")">@(comp.WaitingMinutesChangePercent.HasValue ? $"{(comp.WaitingMinutesChangePercent > 0 ? "+" : "")}{comp.WaitingMinutesChangePercent:F1}%" : "—")</td></tr>
                <tr><td>Dispatch Reliability</td><td>@(comp.Baseline != null ? $"{comp.Baseline.DispatchReliabilityPercent:F1}%" : "—")</td><td>@($"{comp.Current.DispatchReliabilityPercent:F1}%")</td><td class="@(comp.ReliabilityChangePoints > 0 ? "sp-text-success" : "sp-text-danger")">@(comp.ReliabilityChangePoints.HasValue ? $"{(comp.ReliabilityChangePoints > 0 ? "+" : "")}{comp.ReliabilityChangePoints:F1} pts" : "—")</td></tr>
                <tr><td>Est. Fuel Cost</td><td>@(comp.Baseline != null ? $"R{comp.Baseline.EstimatedFuelCost:N2}" : "—")</td><td>@($"R{comp.Current.EstimatedFuelCost:N2}")</td><td class="@(comp.FuelCostChangePercent < 0 ? "sp-text-success" : "sp-text-danger")">@(comp.FuelCostChangePercent.HasValue ? $"{(comp.FuelCostChangePercent > 0 ? "+" : "")}{comp.FuelCostChangePercent:F1}%" : "—")</td></tr>
                <tr><td>Est. CO₂</td><td>@(comp.Baseline != null ? $"{comp.Baseline.EstimatedCo2Kg:N1} kg" : "—")</td><td>@($"{comp.Current.EstimatedCo2Kg:N1} kg")</td><td class="@(comp.Co2ChangePercent < 0 ? "sp-text-success" : "sp-text-danger")">@(comp.Co2ChangePercent.HasValue ? $"{(comp.Co2ChangePercent > 0 ? "+" : "")}{comp.Co2ChangePercent:F1}%" : "—")</td></tr>
                <tr><td>Missed Windows</td><td>@(comp.Baseline?.MissedArrivalWindows.ToString() ?? "—")</td><td>@comp.Current.MissedArrivalWindows</td><td>@(comp.Baseline != null ? (comp.Current.MissedArrivalWindows - comp.Baseline.MissedArrivalWindows).ToString("+0;-0;0") : "—")</td></tr>
                <tr><td>Recommendations Generated</td><td>@(comp.Baseline?.RecommendationsGenerated.ToString() ?? "0")</td><td>@comp.Current.RecommendationsGenerated</td><td>—</td></tr>
                <tr><td>High-Risk Trips</td><td>@(comp.Baseline?.HighRiskTrips.ToString() ?? "—")</td><td>@comp.Current.HighRiskTrips</td><td>—</td></tr>
            </tbody>
        </table>
    </div>
    <div style="font-size:.8125rem;color:var(--sp-text-subtle);margin-top:.75rem">@comp.PeriodNote</div>
}
