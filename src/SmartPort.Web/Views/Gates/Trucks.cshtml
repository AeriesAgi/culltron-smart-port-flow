@model SmartPort.Application.Interfaces.PagedResult<SmartPort.Application.Interfaces.TruckListDto>
@{
    ViewData["Title"] = "Truck Queue";
    var filter = ViewBag.Filter as SmartPort.Application.Interfaces.TruckFilterDto ?? new();
}
<div class="sp-toolbar">
    <form method="get" class="sp-filter-bar">
        <input name="SearchTerm" value="@filter.SearchTerm" class="sp-form__input sp-form__input--sm" placeholder="Registration or transporter…" />
        <select name="Status" class="sp-form__select sp-form__select--sm">
            <option value="">All Status</option>
            @foreach (var s in Enum.GetValues<SmartPort.Domain.Enums.TruckStatus>()) { <option value="@s" selected="@(filter.Status == s)">@s</option> }
        </select>
        <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary">Filter</button>
        <a asp-action="Trucks" class="sp-btn sp-btn--sm sp-btn--outline">Reset</a>
    </form>
    <div class="sp-toolbar__actions">
        <a asp-action="Index" class="sp-btn sp-btn--sm sp-btn--outline">Gate Status</a>
        <a asp-action="Transactions" class="sp-btn sp-btn--sm sp-btn--outline">Transactions</a>
    </div>
</div>
<div class="sp-card">
    <table class="sp-table">
        <thead><tr><th>Registration</th><th>Transporter</th><th>Driver</th><th>Status</th><th>Booking Ref</th><th>Container</th><th>Appointment</th><th>Gate In</th><th>Dwell</th></tr></thead>
        <tbody>
            @foreach (var t in Model.Items)
            {
                var sc = t.Status switch {
                    SmartPort.Domain.Enums.TruckStatus.InQueue  => "warning",
                    SmartPort.Domain.Enums.TruckStatus.AtGate   => "info",
                    SmartPort.Domain.Enums.TruckStatus.InYard   => "success",
                    SmartPort.Domain.Enums.TruckStatus.Rejected => "danger",
                    SmartPort.Domain.Enums.TruckStatus.GateOutComplete => "muted",
                    _ => "default"
                };
                <tr>
                    <td class="sp-table__mono"><strong>@t.RegistrationNumber</strong></td>
                    <td>@t.TransporterName</td>
                    <td>@t.DriverName</td>
                    <td><span class="sp-badge sp-badge--@sc">@t.Status</span></td>
                    <td class="sp-table__mono">@(t.BookingReference ?? "—")</td>
                    <td class="sp-table__mono">@(t.TargetContainerNumber ?? "—")</td>
                    <td class="sp-table__mono">@(t.AppointmentDateTime?.ToString("dd MMM HH:mm") ?? "—")</td>
                    <td class="sp-table__mono">@(t.GateInTime?.ToString("HH:mm") ?? "—")</td>
                    <td>@(t.PortDwellMinutes.HasValue ? $"{t.PortDwellMinutes:F0} min" : "—")</td>
                </tr>
            }
            @if (!Model.Items.Any())
            { <tr><td colspan="9" class="sp-table__empty">No trucks match the current filter.</td></tr> }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model)
</div>
