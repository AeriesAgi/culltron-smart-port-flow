@using SmartPort.Infrastructure.Services
@{
    ViewData["Title"] = "AI Command Centre";
    var snapshot = ViewBag.Snapshot as SmartPortOperationsSnapshot;
    var context = ViewBag.Context as OperationalContext;
}

<section class="sp-command-hero sp-premium-panel">
    <div>
        <div class="sp-agent-badge"><span class="sp-live-dot"></span> AI Agent Command Centre · Local deterministic intelligence</div>
        <h1>AI Command Centre</h1>
        <p>System-level operational intelligence, risk scoring, autonomous monitoring lanes and recommended actions for the synthetic smart-port demo state.</p>
        <div class="sp-command-actions">
            <button class="sp-btn sp-btn--primary" type="button" data-shift-brief>Generate Shift Brief</button>
            <a class="sp-btn sp-btn--outline" asp-controller="Copilot" asp-action="Index" asp-route-prompt="what should operators do first">Open Copilot Chat</a>
            <a class="sp-btn sp-btn--outline" asp-controller="Simulator" asp-action="Index">Run Scenario</a>
            <a class="sp-btn sp-btn--outline" asp-controller="TruckTracking" asp-action="Index">View Truck Tracking</a>
            <a class="sp-btn sp-btn--outline" asp-controller="Impact" asp-action="Index">Executive Impact</a>
            <a class="sp-btn sp-btn--outline" asp-controller="Brief" asp-action="Index">Executive Brief</a>
        </div>
    </div>
    @if (snapshot != null)
    {
        <div class="sp-command-risk-dial sp-command-risk-dial--@snapshot.TopRiskSeverity.ToLowerInvariant()">
            <span>@snapshot.TopRiskSeverity</span>
            <strong>@snapshot.Confidence%</strong>
            <small>confidence</small>
        </div>
    }
</section>

<div class="sp-alert sp-alert--info" style="margin-bottom:1.25rem">
    <i data-feather="info"></i>
    <span>This page is not a chat screen. It answers “what is happening across the port right now?” using synthetic demo data and deterministic local rules. Production integrations would connect to TOS/IPMS, gate systems, GPS/telematics and energy data.</span>
</div>

@if (snapshot != null)
{
    <section class="sp-business-grid sp-business-grid--compact">
        <article class="sp-business-card"><span>Current operational risk</span><strong>@snapshot.TopRiskSeverity</strong><small>@snapshot.TopRisk</small></article>
        <article class="sp-business-card"><span>Estimated impact opportunity</span><strong>@Math.Round(snapshot.IdlingMinutes * 0.32m, 0) min</strong><small>indicative idling reduction window</small></article>
        <article class="sp-business-card"><span>Recommended next action</span><strong>Meter arrivals</strong><small>@snapshot.ImmediateActions.FirstOrDefault()</small></article>
        <article class="sp-business-card"><span>Business context</span><strong>Demo ready</strong><small><a asp-controller="PilotReadiness" asp-action="Index">Pilot roadmap</a> · <a asp-controller="Copilot" asp-action="Index" asp-route-prompt="Explain NCIC alignment">Ask NCIC alignment</a></small></article>
    </section>
}

@if (snapshot != null)
{
    <section class="sp-command-snapshot-grid">
        <article class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@snapshot.TrucksInQueue</div><div class="sp-kpi-card__label">Queued Trucks</div><div class="sp-kpi-card__sub">Gate pressure input</div></div></article>
        <article class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@($"{snapshot.BerthUtilisation:F0}%")</div><div class="sp-kpi-card__label">Berth Utilisation</div><div class="sp-kpi-card__sub">@snapshot.VesselsAtAnchor vessel(s) at anchor</div></div></article>
        <article class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@($"{snapshot.YardOccupancy:F1}%")</div><div class="sp-kpi-card__label">Yard Occupancy</div><div class="sp-kpi-card__sub">Dwell and capacity signal</div></div></article>
        <article class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@($"{snapshot.EmissionsIdlingEstimateKg:F1} kg")</div><div class="sp-kpi-card__label">CO₂ Exposure</div><div class="sp-kpi-card__sub">@($"{snapshot.IdlingMinutes:F0} idling min")</div></div></article>
        <article class="sp-kpi-card sp-kpi-card--interactive"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@snapshot.ActiveDisruptions</div><div class="sp-kpi-card__label">Disruptions</div><div class="sp-kpi-card__sub">@snapshot.LoadSheddingEnergyRisk</div></div></article>
    </section>

    <section class="sp-command-layout">
        <article class="sp-card sp-command-top-risk">
            <div class="sp-card__header">
                <h3 class="sp-card__title">Top Risk Panel</h3>
                <span class="sp-badge sp-badge--@(snapshot.TopRiskSeverity.ToLowerInvariant() == "critical" ? "danger" : snapshot.TopRiskSeverity.ToLowerInvariant() == "high" ? "warning" : "info")">@snapshot.TopRiskSeverity</span>
            </div>
            <div class="sp-command-risk-body">
                <h2>@snapshot.TopRisk</h2>
                <p>@snapshot.TopRiskReason</p>
                <div class="sp-command-risk-meta">
                    <div><span>Affected area</span><strong>@snapshot.AffectedArea</strong></div>
                    <div><span>Expected consequence</span><strong>@snapshot.ExpectedConsequence</strong></div>
                    <div><span>Top bottleneck</span><strong>@snapshot.TopGateBottleneck</strong></div>
                </div>
            </div>
        </article>

        <article class="sp-card">
            <div class="sp-card__header"><h3 class="sp-card__title">What the AI is Monitoring</h3><span class="sp-card__meta">@snapshot.DataNote</span></div>
            <div class="sp-monitoring-lanes">
                @foreach (var lane in snapshot.MonitoringLanes)
                {
                    var tone = lane.Status.ToLowerInvariant() switch { "critical" => "danger", "high" => "warning", "stable" => "success", _ => "info" };
                    <div class="sp-monitoring-lane sp-monitoring-lane--@tone">
                        <span class="sp-command-tile__signal"></span>
                        <div><strong>@lane.Name</strong><small>@lane.Reason</small></div>
                        <div class="sp-monitoring-lane__metric"><b>@lane.Metric</b><span>@lane.Confidence% confidence</span></div>
                        <span class="sp-badge sp-badge--@tone">@lane.Status</span>
                    </div>
                }
            </div>
        </article>
    </section>

    <section class="sp-command-layout sp-command-layout--actions">
        <article class="sp-card">
            <div class="sp-card__header"><h3 class="sp-card__title">Recommended Operator Action Plan</h3><span class="sp-card__meta">Explainable response loop</span></div>
            <div class="sp-action-plan-grid">
                <div><h4>Immediate</h4>@foreach (var item in snapshot.ImmediateActions){<p>@item</p>}</div>
                <div><h4>Next 30 minutes</h4>@foreach (var item in snapshot.Next30Minutes){<p>@item</p>}</div>
                <div><h4>Next 2 hours</h4>@foreach (var item in snapshot.Next2Hours){<p>@item</p>}</div>
                <div><h4>Escalation / communication</h4>@foreach (var item in snapshot.EscalationActions){<p>@item</p>}</div>
            </div>
        </article>

        <aside class="sp-card sp-shift-brief-card">
            <div class="sp-card__header"><h3 class="sp-card__title">Deterministic Shift Brief</h3><span class="sp-card__meta">Generated locally</span></div>
            <p id="shiftBriefText">@snapshot.ShiftBrief</p>
            <div class="sp-command-focus-lists">
                <h4>Hold outside port</h4>
                @foreach (var item in snapshot.HoldOutsidePortCandidates){<span>@item</span>}
                <h4>Priority release</h4>
                @foreach (var item in snapshot.PriorityReleaseCandidates){<span>@item</span>}
            </div>
        </aside>
    </section>

    <section class="sp-card">
        <div class="sp-card__header"><h3 class="sp-card__title">Decision Support Links</h3><span class="sp-card__meta">Audit trail and operator workflow</span></div>
        <div class="sp-copilot-action-row" style="padding:1rem">
            @foreach (var link in snapshot.ActionLinks)
            {
                <a class="sp-copilot-action-card" href="@link.Url"><span>@link.Icon</span><strong>@link.Title</strong><small>@link.Description</small></a>
            }
        </div>
    </section>
}
else if (context != null)
{
    <div class="sp-card" style="padding:1.25rem">AI Command Centre context loaded: @context.VesselsInPort vessels, @context.TrucksInQueue queued trucks.</div>
}

@section Scripts {
<script>
(() => {
  const btn = document.querySelector('[data-shift-brief]');
  const text = document.getElementById('shiftBriefText');
  btn?.addEventListener('click', () => {
    text?.classList.add('sp-shimmer');
    setTimeout(() => text?.classList.remove('sp-shimmer'), 650);
    text?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
})();
</script>
}
