@{ ViewData["Title"] = "Driver Companion"; var refs = ViewBag.DemoReferences as IReadOnlyList<string> ?? new []{"SPQ-2026-0042"}; }
<div class="driver-shell"><section class="driver-phone-card"><span class="sp-badge sp-badge--ai">Driver Companion</span><h1>Check your Smart Port queue status</h1><p>Enter your truck registration, booking reference, or job/container reference. Drivers only see the matched job/status.</p><form method="get" onsubmit="event.preventDefault(); location.href='/driver/status/'+encodeURIComponent(this.reference.value);"><input class="sp-form__input sp-form__input--lg" name="reference" placeholder="SPQ-2026-0042 or KZN-482-TR" required/><button class="sp-btn sp-btn--primary sp-btn--full sp-btn--lg">View my queue</button></form><div class="demo-chips">@foreach(var r in refs){<a href="/driver/status/@r">@r</a>}</div></section></div>
