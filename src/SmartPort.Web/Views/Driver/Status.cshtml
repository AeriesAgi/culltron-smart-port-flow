@using SmartPort.Application.DTOs
@model FleetTruckDto
@{ ViewData["Title"] = "Driver Status"; }
<div class="driver-shell"><section class="driver-phone-card status-card"><div class="truck-card__head"><span class="sp-badge sp-badge--ai">Queue @Model.QueueNumber</span><span class="sp-badge sp-badge--green">@Model.CurrentStatus</span></div><h1>@Model.TruckRegistration</h1><p>@Model.DriverName · @Model.FleetOperatorName</p>@if (TempData["Success"] is string ok){<div class="sp-alert sp-alert--success">@ok</div>}@if (TempData["Warning"] is string warn){<div class="sp-alert sp-alert--warning">@warn</div>}@if (TempData["CopilotAnswer"] is string answer){<div class="notification-row"><strong>Copilot</strong><p>@answer</p></div>}<div class="driver-instruction">@Model.CurrentInstruction.Instruction</div><p>@Model.CurrentInstruction.Reason</p><dl class="driver-dl"><dt>Booking / job</dt><dd>@Model.BookingReference / @Model.JobReference</dd><dt>Container</dt><dd>@Model.ContainerReference</dd><dt>Appointment</dt><dd>@Model.AppointmentTime.ToLocalTime().ToString("HH:mm")</dd><dt>Call-forward</dt><dd>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</dd><dt>Gate</dt><dd>@Model.AssignedGate</dd><dt>Zone</dt><dd>@Model.BerthYardStagingZone</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Availability</dt><dd>@Model.DriverAvailabilityStatus</dd><dt>Last location</dt><dd>@Model.LastKnownLocationLabel</dd><dt>Impact</dt><dd>@Model.EstimatedIdlingMinutesAvoided min / @Model.EstimatedCo2KgAvoided.ToString("N1") kg CO₂ avoided</dd></dl><div class="notification-row"><strong>Latest alert</strong><p>@Model.LatestNotification</p><span class="sp-badge sp-badge--ai">WhatsApp @Model.WhatsAppNotificationStatus</span> <span class="sp-badge sp-badge--green">In-app @Model.InAppNotificationStatus</span></div><div class="qr-placeholder">Gate QR/ref placeholder: @Model.BookingReference</div><h2>Driver actions</h2><div class="ack-grid">@foreach(var item in new[]{("Check ETA","HOW LONG"),("I am holding","HOLDING"),("I arrived at staging","ARRIVED_STAGING"),("I am proceeding to gate","PROCEEDING_GATE"),("I arrived at gate","ARRIVED_GATE"),("Job completed","COMPLETED"),("Taking 15 min break","BREAK 15"),("Delayed 20 min","DELAYED 20"),("Report issue","ISSUE"),("Share demo location check-in","LOCATION_SHARED")}){<form method="post" action="/driver/action"><input type="hidden" name="reference" value="@Model.BookingReference"/><input type="hidden" name="commandText" value="@item.Item2"/><button class="sp-btn sp-btn--outline">@item.Item1</button></form>}</div><form method="post" action="/driver/copilot" class="sp-form-inline"><input type="hidden" name="reference" value="@Model.BookingReference"/><input name="question" value="How long until I am called forward?"/><button class="sp-btn sp-btn--primary">Ask Copilot</button></form><div class="notification-row"><strong>Driver Status Assistant</strong><p>WhatsApp LiveTest commands: STATUS, ETA, HOW LONG, WHAT NOW, READY, BREAK 15, DELAYED 20, ARRIVED_GATE, ISSUE or share a WhatsApp location check-in.</p></div><form method="post" action="/driver/acknowledge" class="ack-grid"><input type="hidden" name="reference" value="@Model.BookingReference"/><button name="acknowledgement" value="Seen" class="sp-btn sp-btn--outline">Seen</button><button name="acknowledgement" value="Holding" class="sp-btn sp-btn--warning">Holding</button><button name="acknowledgement" value="Proceeding" class="sp-btn sp-btn--success">Proceeding</button></form>@if(Model.AcknowledgementState != null){<p class="sp-alert sp-alert--success">Acknowledged: @Model.AcknowledgementState</p>}<h2>Status timeline</h2>@foreach(var step in Model.Timeline.OrderByDescending(s=>s.Timestamp)){<div class="timeline-step"><strong>@step.Status</strong><span>@step.Timestamp.ToLocalTime().ToString("HH:mm")</span><p>@step.Note</p></div>}<h2>Notification history</h2>@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp)){<div class="notification-row"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><p>@n.Message</p></div>}<p class="sp-muted">Last updated @Model.LastUpdated.ToLocalTime().ToString("g")</p></section></div>
