@using SmartPort.Application.DTOs
@model FleetTruckDto
@{ ViewData["Title"] = "Driver Status"; }
<div class="driver-shell"><section class="driver-phone-card status-card"><div class="truck-card__head"><span class="sp-badge sp-badge--ai">Queue @Model.QueueNumber</span><span class="sp-badge sp-badge--green">@Model.CurrentStatus</span></div><h1>@Model.TruckRegistration</h1><p>@Model.DriverName · @Model.FleetOperatorName</p><div class="driver-instruction">@Model.CurrentInstruction.Instruction</div><p>@Model.CurrentInstruction.Reason</p><dl class="driver-dl"><dt>Booking / job</dt><dd>@Model.BookingReference / @Model.JobReference</dd><dt>Container</dt><dd>@Model.ContainerReference</dd><dt>Appointment</dt><dd>@Model.AppointmentTime.ToLocalTime().ToString("HH:mm")</dd><dt>Call-forward</dt><dd>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</dd><dt>Gate</dt><dd>@Model.AssignedGate</dd><dt>Zone</dt><dd>@Model.BerthYardStagingZone</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Impact</dt><dd>@Model.EstimatedIdlingMinutesAvoided min / @Model.EstimatedCo2KgAvoided.ToString("N1") kg CO₂ avoided</dd></dl><div class="notification-row"><strong>Latest alert</strong><p>@Model.LatestNotification</p><span class="sp-badge sp-badge--ai">WhatsApp @Model.WhatsAppNotificationStatus</span> <span class="sp-badge sp-badge--green">In-app @Model.InAppNotificationStatus</span></div><div class="qr-placeholder">Gate QR/ref placeholder: @Model.BookingReference</div><form method="post" action="/driver/acknowledge" class="ack-grid"><input type="hidden" name="reference" value="@Model.BookingReference"/><button name="acknowledgement" value="Seen" class="sp-btn sp-btn--outline">Seen</button><button name="acknowledgement" value="Holding" class="sp-btn sp-btn--warning">Holding</button><button name="acknowledgement" value="Proceeding" class="sp-btn sp-btn--success">Proceeding</button></form>@if(Model.AcknowledgementState != null){<p class="sp-alert sp-alert--success">Acknowledged: @Model.AcknowledgementState</p>}<h2>Status timeline</h2>@foreach(var step in Model.Timeline){<div class="timeline-step"><strong>@step.Status</strong><span>@step.Timestamp.ToLocalTime().ToString("HH:mm")</span><p>@step.Note</p></div>}<h2>Notification history</h2>@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp)){<div class="notification-row"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><p>@n.Message</p></div>}<p class="sp-muted">Last updated @Model.LastUpdated.ToLocalTime().ToString("g")</p></section></div>
