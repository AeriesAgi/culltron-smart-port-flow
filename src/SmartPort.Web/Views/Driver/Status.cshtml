@using SmartPort.Application.DTOs
@model FleetTruckDto
@{ ViewData["Title"] = "Driver Status"; }
<div class="driver-shell"><section class="driver-phone-card status-card"><div class="truck-card__head"><span class="sp-badge sp-badge--ai">Queue @Model.QueueNumber</span><span class="sp-badge sp-badge--green">@Model.CurrentStatus</span></div><h1>@Model.TruckRegistration</h1><p>@Model.DriverName · @Model.FleetOperatorName</p>@if (TempData["Success"] is string ok){<div class="sp-alert sp-alert--success">@ok</div>}@if (TempData["Warning"] is string warn){<div class="sp-alert sp-alert--warning">@warn</div>}@if (TempData["CopilotAnswer"] is string answer){<div class="notification-row"><strong>Copilot</strong><p>@answer</p></div>}<div class="driver-instruction">@Model.CurrentInstruction.Instruction</div><p>@Model.CurrentInstruction.Reason</p><dl class="driver-dl"><dt>Booking / job</dt><dd>@Model.BookingReference / @Model.JobReference</dd><dt>Container</dt><dd>@Model.ContainerReference</dd><dt>Appointment</dt><dd>@Model.AppointmentTime.ToLocalTime().ToString("HH:mm")</dd><dt>Call-forward</dt><dd>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</dd><dt>Gate</dt><dd>@Model.AssignedGate</dd><dt>Zone</dt><dd>@Model.BerthYardStagingZone</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Availability</dt><dd>@Model.DriverAvailabilityStatus</dd><dt>Last app check-in</dt><dd>@(Model.LastLocationCheckIn?.Timestamp.ToLocalTime().ToString("g") ?? "No check-in yet")</dd><dt>Last location</dt><dd>@Model.LastKnownLocationLabel @if(Model.LastLocationCheckIn != null){<span>(@Model.LastLocationCheckIn.Latitude, @Model.LastLocationCheckIn.Longitude)</span>}</dd><dt>Impact</dt><dd>@Model.EstimatedIdlingMinutesAvoided min / @Model.EstimatedCo2KgAvoided.ToString("N1") kg CO₂ avoided</dd></dl><div class="notification-row"><strong>Latest alert</strong><p>@Model.LatestNotification</p><span class="sp-badge sp-badge--green">Driver Companion / Mobile API primary</span> <span class="sp-badge sp-badge--ai">In-app @Model.InAppNotificationStatus</span></div><div class="qr-placeholder">Gate QR/ref placeholder: @Model.BookingReference</div><h2>Share current location / Check in</h2><form method="post" action="/driver/location-checkin" id="webCheckInForm" class="sp-form-inline"><input type="hidden" name="reference" value="@Model.BookingReference"/><input type="hidden" name="latitude" id="checkinLatitude"/><input type="hidden" name="longitude" id="checkinLongitude"/><input type="hidden" name="accuracy" id="checkinAccuracy"/><input name="locationLabel" id="checkinLabel" value="Staging Area A" aria-label="Manual/demo location label"/><button type="button" class="sp-btn sp-btn--primary" id="shareCheckInButton">Share demo location / Check in</button><button class="sp-btn sp-btn--outline">Manual label check-in</button></form><p class="sp-muted">Browser location is requested only after you click. If denied or unavailable, the manual/demo label still sends a successful check-in.</p><h2>Driver actions</h2><div class="ack-grid">@foreach(var item in new[]{("Check ETA","HOW LONG"),("I am holding","HOLDING"),("I arrived at staging","ARRIVED_STAGING"),("I am proceeding to gate","PROCEEDING_GATE"),("I arrived at gate","ARRIVED_GATE"),("Job completed","COMPLETED"),("Taking 15 min break","BREAK 15"),("Delayed 20 min","DELAYED 20"),("Report issue","ISSUE"),("Share demo location check-in","LOCATION_SHARED")}){<form method="post" action="/driver/action"><input type="hidden" name="reference" value="@Model.BookingReference"/><input type="hidden" name="commandText" value="@item.Item2"/><button class="sp-btn sp-btn--outline">@item.Item1</button></form>}</div><form method="post" action="/driver/copilot" class="sp-form-inline"><input type="hidden" name="reference" value="@Model.BookingReference"/><input name="question" value="How long until I am called forward?"/><button class="sp-btn sp-btn--primary">Ask Copilot</button></form><div class="notification-row"><strong>Driver Status Assistant</strong><p>Use the Driver Companion App / web companion for STATUS, ETA, WHAT NOW, READY, BREAK 15, DELAYED 20, ARRIVED_GATE, ISSUE and user-triggered check-ins. Optional connector-ready WhatsApp Cloud API integration for future pilots/live-test messaging.</p></div><form method="post" action="/driver/acknowledge" class="ack-grid"><input type="hidden" name="reference" value="@Model.BookingReference"/><button name="acknowledgement" value="Seen" class="sp-btn sp-btn--outline">Seen</button><button name="acknowledgement" value="Holding" class="sp-btn sp-btn--warning">Holding</button><button name="acknowledgement" value="Proceeding" class="sp-btn sp-btn--success">Proceeding</button></form>@if(Model.AcknowledgementState != null){<p class="sp-alert sp-alert--success">Acknowledged: @Model.AcknowledgementState</p>}<h2>Status and check-in timeline</h2>@foreach(var step in Model.Timeline.OrderByDescending(s=>s.Timestamp)){<div class="timeline-step"><strong>@step.Status</strong><span>@step.Timestamp.ToLocalTime().ToString("HH:mm")</span><p>@step.Note</p><small>@step.Source · @step.Actor</small></div>}<h2>Driver communication timeline</h2>@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp)){<div class="notification-row"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><p>@n.Message</p></div>}<p class="sp-muted">Last updated @Model.LastUpdated.ToLocalTime().ToString("g")</p></section></div>
@section Scripts {<script>document.getElementById('shareCheckInButton')?.addEventListener('click', function(){ const form=document.getElementById('webCheckInForm'); const label=document.getElementById('checkinLabel'); if(!navigator.geolocation){ label.value=label.value||'Manual/demo web companion check-in'; form.submit(); return; } navigator.geolocation.getCurrentPosition(function(pos){ document.getElementById('checkinLatitude').value=pos.coords.latitude.toFixed(6); document.getElementById('checkinLongitude').value=pos.coords.longitude.toFixed(6); document.getElementById('checkinAccuracy').value=Math.round(pos.coords.accuracy); label.value=label.value||'Browser geolocation check-in'; form.submit(); }, function(){ label.value=label.value||'Manual/demo web companion check-in'; form.submit(); }, { enableHighAccuracy:false, timeout:5000, maximumAge:60000 }); });</script>}
