@{
    ViewData["Title"] = "Ops Ingest";
    var sample = ViewBag.Sample as string ?? string.Empty;
    var history = ViewBag.History as IReadOnlyList<SmartPort.Web.Controllers.OpsIngestAuditItem> ?? Array.Empty<SmartPort.Web.Controllers.OpsIngestAuditItem>();
    var last = history.FirstOrDefault();
}
<section class="sp-page-hero"><div><span class="sp-badge">Document-ready operational intelligence</span><h1>Ops Ingest: messy note → structured execution signals</h1><p>Paste berth, gate, fleet or incident text and Smart Port extracts operational signals, classifies disruption type, previews execution-plan actions, asks Gemini for reasoning when configured, and falls back deterministically when not configured.</p></div><a class="sp-btn sp-btn--primary" href="/gemini-agent">Open Gemini Agent</a></section>

<section class="sp-grid sp-grid--2"><article class="sp-card"><h2>Paste operational note</h2><form method="post" action="/ops-ingest/analyze"><textarea class="sp-input" name="operationalNote" rows="8">@sample</textarea><p class="sp-muted">Text-first demo today. Future live sources: IPMS/TOS, berth schedule, gate OCR, weighbridge, fleet GPS, driver app, WhatsApp, ERP, weather/disruption feeds. CSV/PDF/manifest connectors are pilot-ready roadmap items once approved credentials and data-sharing are available.</p><button class="sp-btn sp-btn--primary" type="submit">Analyze note and create audit entry</button></form></article><article class="sp-card"><h2>Latest extraction</h2>@if (last == null) { <p>No ingest run yet. Analyze the sample to preview structured signals.</p> } else { <p><strong>Disruption type:</strong> @last.DisruptionType</p><p><strong>Structured signals:</strong> @last.StructuredSignals</p><p><strong>Execution preview:</strong> @last.PlanPreview</p><p><strong>Gemini/fallback reasoning:</strong> @last.GeminiOrFallbackReasoning</p><p><strong>Source model:</strong> @last.SourceModel</p><p><strong>Approval:</strong> @last.ApprovalStatus</p> }</article></section>

<section class="sp-card sp-mt"><h2>Pilot connector-ready path</h2><ol class="sp-timeline"><li>Paste or upload operational notes in demo mode.</li><li>Map fields for berth, gate, queue, incident, fleet and driver signals.</li><li>Connect approved CSV/API/PDF parser in sandbox.</li><li>Generate execution-plan preview and governance check.</li><li>Route recommended actions to a human approver before mobile/WhatsApp send.</li></ol></section>

<section class="sp-card sp-mt"><h2>Ingest audit/history</h2>@if (!history.Any()) { <p>No ingest audit entries yet.</p> } else { <div class="sp-table-wrap"><table class="sp-table"><thead><tr><th>Time</th><th>Disruption</th><th>Signals</th><th>Plan preview</th><th>Source</th><th>Connector roadmap</th></tr></thead><tbody>@foreach (var item in history) { <tr><td>@item.TimestampUtc.ToString("u")</td><td>@item.DisruptionType</td><td>@item.StructuredSignals</td><td>@item.PlanPreview</td><td>@item.SourceModel</td><td>@item.ConnectorRoadmap</td></tr> }</tbody></table></div> }</section>
