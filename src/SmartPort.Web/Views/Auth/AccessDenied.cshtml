@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Access Denied"; }
<div class="sp-auth-page">
    <div class="sp-auth-card sp-auth-card--error">
        <div class="sp-auth-card__header">
            <div style="font-size:3rem;margin-bottom:.5rem">🔒</div>
            <h1>Access Denied</h1>
            <p>You do not have permission to access this section. Contact your system administrator if you believe this is an error.</p>
        </div>
        <div style="text-align:center;margin-top:1.5rem;display:flex;flex-direction:column;gap:.75rem">
            <a asp-controller="Dashboard" asp-action="Index" class="sp-btn sp-btn--primary">Back to Dashboard</a>
            <a asp-controller="Auth" asp-action="Profile" class="sp-btn sp-btn--outline">View My Profile</a>
        </div>
    </div>
</div>
