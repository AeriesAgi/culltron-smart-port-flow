@using SmartPort.Application.DTOs
@model FleetTruckDto
@{
    Layout = null;
    var refs = ViewBag.DemoReferences as IReadOnlyList<string> ?? Array.Empty<string>();
}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><title>Smart Port Driver Companion</title><link rel="stylesheet" href="/css/app.css"/><style>body{margin:0;background:#020617;color:#fff;font-family:Inter,system-ui,sans-serif}.driver-app-shell{min-height:100vh;max-width:520px;margin:0 auto;background:radial-gradient(circle at 70% 0,rgba(34,211,238,.20),transparent 32%),linear-gradient(180deg,#06111f,#020617);padding:18px 16px 92px}.app-top{display:flex;align-items:center;justify-content:space-between;padding:12px 0}.app-logo{font-weight:900;letter-spacing:-.03em}.app-card{border:1px solid rgba(125,211,252,.24);background:linear-gradient(145deg,rgba(15,23,42,.92),rgba(8,47,73,.56));border-radius:26px;padding:16px;margin:12px 0;box-shadow:0 20px 60px rgba(0,0,0,.32)}.app-hero h1{font-size:2.25rem;line-height:.95;margin:.45rem 0}.app-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.app-metric{background:rgba(2,6,23,.45);border:1px solid rgba(125,211,252,.16);border-radius:18px;padding:12px}.app-metric strong{display:block;font-size:1.25rem}.app-bottom{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);width:min(500px,calc(100% - 26px));display:grid;grid-template-columns:repeat(5,1fr);gap:7px;padding:8px;border:1px solid rgba(125,211,252,.22);border-radius:24px;background:rgba(2,6,23,.88);backdrop-filter:blur(18px)}.app-bottom a{color:#bfdbfe;text-decoration:none;text-align:center;font-size:.72rem}.app-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.app-actions form,.app-actions button{width:100%}.app-input{width:100%;box-sizing:border-box;border-radius:16px;border:1px solid rgba(125,211,252,.28);background:rgba(2,6,23,.72);color:#fff;padding:12px;margin:6px 0}.app-timeline{border-left:1px solid rgba(34,211,238,.32);padding-left:12px;margin-left:5px}.app-timeline div{margin:12px 0}.app-safe{font-size:.82rem;color:#bae6fd}</style></head><body><main class="driver-app-shell">
<header class="app-top"><div class="app-logo">⬡ Smart Port Driver</div><span class="sp-badge sp-badge--green">App shell</span></header>
@if (TempData["Success"] is string ok){<div class="sp-alert sp-alert--success">@ok</div>}@if (TempData["Warning"] is string warn){<div class="sp-alert sp-alert--warning">@warn</div>}
<section id="home" class="app-card app-hero"><span class="sp-badge sp-badge--ai">Queue @Model.QueueNumber · @Model.CurrentStatus</span><h1>@Model.TruckRegistration</h1><p>@Model.DriverName · @Model.FleetOperatorName</p><div class="driver-instruction">@Model.CurrentInstruction.Instruction</div><p>@Model.CurrentInstruction.Reason</p><div class="app-grid"><div class="app-metric"><small>Call-forward</small><strong>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</strong></div><div class="app-metric"><small>Gate</small><strong>@Model.AssignedGate</strong></div><div class="app-metric"><small>Stage</small><strong>@Model.BerthYardStagingZone</strong></div><div class="app-metric"><small>Risk</small><strong>@Model.DelayRisk</strong></div></div></section>
<section id="job" class="app-card"><h2>Assigned job</h2><dl class="driver-dl"><dt>Booking / job</dt><dd>@Model.BookingReference / @Model.JobReference</dd><dt>Container</dt><dd>@Model.ContainerReference</dd><dt>Fleet tracker state</dt><dd>@(Model.LastLocationCheckIn?.Timestamp.ToLocalTime().ToString("g") ?? "No app check-in yet") · @Model.LastKnownLocationLabel</dd><dt>Impact</dt><dd>@Model.EstimatedIdlingMinutesAvoided min / @Model.EstimatedCo2KgAvoided.ToString("N1") kg CO₂ avoided</dd></dl><form method="get" action="/driver-app"><select class="app-input" onchange="location.href='/driver-app/'+this.value">@foreach(var r in refs){<option selected="@(r==Model.BookingReference)" value="@r">@r</option>}</select></form></section>
<section id="actions" class="app-card"><h2>Allowed actions</h2><div class="app-actions">@foreach(var item in new[]{("Confirm received",DriverEventType.DriverAcknowledgedInstruction),("Arrived staging",DriverEventType.DriverArrivedAtStaging),("At gate",DriverEventType.DriverArrivedAtGate),("Report delay",DriverEventType.DriverDelayed),("Report incident",DriverEventType.DriverIssueReported),("Job complete",DriverEventType.DriverCompletedJob)}){<form method="post" action="/driver-app/action"><input type="hidden" name="reference" value="@Model.BookingReference"/><input type="hidden" name="eventType" value="@item.Item2"/><button class="sp-btn sp-btn--outline">@item.Item1</button></form>}</div></section>
<section id="checkin" class="app-card"><h2>Location check-in</h2><p class="app-safe">Location is sent only when you tap Check In. No background tracking.</p><form method="post" action="/driver-app/checkin" id="checkinForm"><input type="hidden" name="reference" value="@Model.BookingReference"/><input type="hidden" name="latitude" id="lat"/><input type="hidden" name="longitude" id="lng"/><input class="app-input" name="locationLabel" id="label" value="Driver Companion check-in"/><button type="button" class="sp-btn sp-btn--primary" id="geoBtn">Use GPS and Check In</button><button class="sp-btn sp-btn--outline">Send demo/manual check-in</button></form></section>
<section id="copilot" class="app-card"><h2>Driver Copilot</h2>@if(TempData["CopilotAnswer"] is string answer){<div class="notification-row"><strong>Copilot · @TempData["CopilotSource"]</strong><p>@answer</p></div>}<form method="post" action="/driver-app/copilot"><input type="hidden" name="reference" value="@Model.BookingReference"/><input class="app-input" name="question" value="What should I do next?"/><button class="sp-btn sp-btn--primary">Ask Copilot</button></form><div class="ack-grid">@foreach(var q in new[]{"Where should I go?","Why am I delayed?","What happens after staging?","How do I report an issue?"}){<form method="post" action="/driver-app/copilot"><input type="hidden" name="reference" value="@Model.BookingReference"/><input type="hidden" name="question" value="@q"/><button class="sp-btn sp-btn--outline">@q</button></form>}</div></section>
<section id="alerts" class="app-card"><h2>Notifications & audit</h2><div class="app-timeline">@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp).Take(8)){<div><strong>@n.Channel · @n.Status</strong><p>@n.Message</p><small>@n.Timestamp.ToLocalTime().ToString("g") · @n.Source</small></div>}</div></section>
<section id="profile" class="app-card"><h2>Profile & safety</h2><p>@Model.DriverName · @Model.TruckRegistration</p><p class="app-safe">Driver Companion uses Smart Port APIs only. Gemini and connector secrets stay server-side. WhatsApp is optional connector support, not required for this app.</p></section>
<nav class="app-bottom"><a href="#home">Home</a><a href="#job">Job</a><a href="#actions">Actions</a><a href="#checkin">Check-in</a><a href="#copilot">Copilot</a></nav>
</main><script>document.getElementById('geoBtn')?.addEventListener('click',()=>{const f=document.getElementById('checkinForm'); if(!navigator.geolocation){f.submit();return;} navigator.geolocation.getCurrentPosition(p=>{document.getElementById('lat').value=p.coords.latitude.toFixed(6);document.getElementById('lng').value=p.coords.longitude.toFixed(6);document.getElementById('label').value='GPS Driver Companion check-in';f.submit();},()=>f.submit(),{enableHighAccuracy:true,timeout:7000});});</script></body></html>
