@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Features"; }
<section class="spx-page-hero"><div class="container spx-split"><div><span class="spx-kicker">Enterprise AI logistics features</span><h1>Features built around the operational execution loop</h1><p>Smart Port focuses on practical coordination: queue state, staging, gate release, driver readiness, exception handling, audit trail and integration readiness.</p><div class="spx-actions"><a href="/demo-access?next=/fleet" class="sp-btn sp-btn--primary sp-btn--lg">Fleet Dashboard</a><a href="/demo-access?next=/Copilot" class="sp-btn sp-btn--outline sp-btn--lg">Copilot</a></div></div><div class="spx-control-tower"><span></span><span></span><span></span></div></div></section>
<section class="spx-section spx-section--deep"><div class="container"><div class="spx-feature-matrix">
@foreach (var item in new[]{("Command-centre dashboard","Premium internal dashboard with port, gate, truck and impact signals."),("Execution plan generator","AI/fallback plan that converts congestion into truck-level actions."),("Fleet owner console","Fleet queue, truck detail, notification controls and settings readiness."),("Driver queue companion","Mobile-first status, allowed actions and Copilot answers."),("WhatsApp LiveTest readiness","Meta webhook verification, inbound commands, statuses, location and safety blocking."),("Android companion","Kotlin source, configurable backend URL and CI APK artifact workflow."),("Gemini/fallback Copilot","GEMINI_API_KEY driven responses with deterministic fallback when absent."),("Emissions and idling impact","Transparent estimates tied to queue and execution-plan actions."),("Audit trail","Notification history and operational events preserve what changed and why.")}){<article><h3>@item.Item1</h3><p>@item.Item2</p></article>}
</div></div></section>
<section class="spx-section"><div class="container spx-split"><div><span class="spx-kicker">Safe demo boundaries</span><h2>Protected internal routes</h2><p>Dashboard, Fleet, Driver, Truck, Execution, Copilot, Reports, Disruptions, Recommendations and mobile APIs sit behind the demo access boundary. The WhatsApp webhook remains public for Meta verification and inbound delivery.</p></div><div class="spx-metric-stack"><div><strong>/demo-access</strong><span>Role credentials when enabled</span></div><div><strong>/webhooks/whatsapp</strong><span>Public callback, token verified</span></div><div><strong>/api/mobile/*</strong><span>Backend-only AI and messaging secrets</span></div></div></div></section>
