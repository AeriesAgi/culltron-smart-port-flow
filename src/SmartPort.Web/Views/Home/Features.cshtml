@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Features"; }
<section class="sp-hero sp-hero--sm"><div class="sp-hero__bg"></div><div class="container sp-hero__inner"><h1 class="sp-hero__headline">Platform Features</h1></div></section>
<section class="sp-section sp-section--white"><div class="container">
    <div class="sp-feature-section"><h2>Real-Time Operational Picture</h2><ul class="sp-checklist"><li>Live vessel status board — approaching, at anchor, berthed, cargo operations, departed</li><li>Berth occupancy grid with visual availability status</li><li>Yard block utilisation by zone with critical/near-capacity flags</li><li>Gate queue counter per gate with estimated wait times</li><li>Active alerts and incident summary panel</li><li>AI recommendation panel with prioritised, actionable insights</li></ul></div>
    <div class="sp-feature-section"><h2>Vessel & Berth Management</h2><ul class="sp-checklist"><li>Full vessel registry with IMO, MMSI, call sign, flag, operator, and agent</li><li>Voyage tracking — previous port, next port, voyage number</li><li>ETA/ETD scheduling with actual vs planned comparison</li><li>Berth assignment workflow with cargo plan approval</li><li>Turnaround time tracking and delay capture with root cause</li><li>Visual berth schedule planner — next 7 days</li></ul></div>
    <div class="sp-feature-section"><h2>Container & Yard Operations</h2><ul class="sp-checklist"><li>ISO 6346 container number tracking from gate-in to gate-out</li><li>Reefer and hazardous cargo classification and alerts</li><li>Dwell time monitoring with 72-hour free time threshold alerts</li><li>Yard block occupancy by zone — import, export, reefer, hazmat, transit, empty</li><li>Container customs status tracking (SARS release status)</li><li>On-hold container management with reason capture</li></ul></div>
    <div class="sp-feature-section"><h2>Document & Compliance</h2><ul class="sp-checklist"><li>13 document types: B/L, manifest, customs declaration, DG declaration, phyto certificate, vessel clearance, and more</li><li>Required-by date tracking with overdue detection and alerts</li><li>Submission → review → approve/reject workflow with full audit trail</li><li>SARS, SAMSA, and DAFF compliance integration pathways</li><li>Rejection reason capture and re-submission workflow</li></ul></div>
    <div class="sp-feature-section"><h2>AI & Intelligence Layer</h2><ul class="sp-checklist"><li>Automatic anchorage wait detection and berth reallocation suggestions</li><li>Gate queue mitigation recommendations with lane activation guidance</li><li>Container dwell time escalation with demurrage revenue estimates</li><li>Document chase alerts for departure-critical documents</li><li>Impact estimates for each recommendation</li><li>Accept / Dismiss workflow with operator notes and audit trail</li></ul></div>
</div></section>
