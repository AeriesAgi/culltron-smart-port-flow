@model SmartPort.Web.Controllers.ContactFormModel
@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Contact Us"; }
<section class="sp-section sp-section--white" style="padding-top:6rem">
    <div class="container" style="max-width:680px;margin:0 auto">
        @if (TempData["Success"] != null)
        { <div class="sp-alert sp-alert--success" style="margin-bottom:1.5rem">✓ @TempData["Success"]</div> }
        <h1 style="font-size:2rem;font-weight:700;margin-bottom:.5rem">Get in Touch</h1>
        <p style="color:#64748b;margin-bottom:2rem">Enquire about a pilot, demo, or partnership. Our team responds within one business day.</p>
        <form asp-action="Contact" method="post" class="sp-card" style="padding:2rem">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="sp-form__errors"></div>
            <div class="sp-form__grid sp-form__grid--2">
                <div class="sp-form__group sp-form__group--full">
                    <label asp-for="FullName" class="sp-form__label">Full Name *</label>
                    <input asp-for="FullName" class="sp-form__input" />
                    <span asp-validation-for="FullName" class="sp-form__error"></span>
                </div>
                <div class="sp-form__group">
                    <label asp-for="Email" class="sp-form__label">Email Address *</label>
                    <input asp-for="Email" class="sp-form__input" />
                    <span asp-validation-for="Email" class="sp-form__error"></span>
                </div>
                <div class="sp-form__group">
                    <label asp-for="Phone" class="sp-form__label">Phone Number</label>
                    <input asp-for="Phone" class="sp-form__input" placeholder="+27 31 000 0000" />
                </div>
                <div class="sp-form__group">
                    <label asp-for="Organisation" class="sp-form__label">Organisation</label>
                    <input asp-for="Organisation" class="sp-form__input" placeholder="Transnet Port Terminals, etc." />
                </div>
                <div class="sp-form__group">
                    <label asp-for="Enquiry" class="sp-form__label">Enquiry Type</label>
                    <select asp-for="Enquiry" class="sp-form__select">
                        <option>Pilot Programme</option>
                        <option>Product Demo</option>
                        <option>Enterprise Pricing</option>
                        <option>Technical Integration</option>
                        <option>Partnership</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="sp-form__group sp-form__group--full">
                    <label asp-for="Message" class="sp-form__label">Message *</label>
                    <textarea asp-for="Message" class="sp-form__textarea" rows="5" placeholder="Tell us about your port operations and what you're looking to achieve…"></textarea>
                    <span asp-validation-for="Message" class="sp-form__error"></span>
                </div>
            </div>
            <button type="submit" class="sp-btn sp-btn--primary" style="margin-top:.5rem">Send Message</button>
        </form>
        <div style="margin-top:2rem;color:#64748b;font-size:.875rem">
            <p><strong style="color:#94a3b8">Email:</strong> support@smartport.co.za</p>
            <p><strong style="color:#94a3b8">Phone:</strong> +27 31 000 0000</p>
            <p><strong style="color:#94a3b8">Address:</strong> Durban, KwaZulu-Natal, South Africa</p>
        </div>
    </div>
</section>
