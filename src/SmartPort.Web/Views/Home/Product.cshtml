@{ Layout = "_LayoutPublic"; ViewData["Title"] = "The Platform"; }
<section class="sp-hero sp-hero--sm"><div class="sp-hero__bg"></div>
    <div class="container sp-hero__inner"><h1 class="sp-hero__headline">The SmartPort Platform</h1><p class="sp-hero__sub">A complete operations intelligence system for modern port and terminal management.</p></div>
</section>
<section class="sp-section sp-section--white"><div class="container">
    <div class="sp-section__header"><h2>End-to-End Port Operations</h2><p>From vessel approach to cargo delivery — every step tracked, monitored, and optimised.</p></div>
    <div class="sp-modules-grid">
        <div class="sp-module-card"><div class="sp-module-card__icon">⚓</div><h3>Vessel Scheduling</h3><p>Full vessel lifecycle from expected arrival through berthing to departure. ETAs, delays, voyage records, and turnaround performance.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🗓️</div><h3>Berth Planning</h3><p>Visual berth planner with occupancy timeline, assignment workflow, conflict detection, and utilisation analytics.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">📦</div><h3>Container Management</h3><p>ISO 6346 container tracking, dwell time monitoring, yard slot management, reefer and hazardous cargo tracking.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🏗️</div><h3>Yard Operations</h3><p>Block-level yard occupancy, zone management (import/export/reefer/hazmat), near-capacity and critical alerts.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🚛</div><h3>Gate &amp; Landside</h3><p>Truck appointment management, queue monitoring across all gates, OCR/RFID integration readiness, transaction logs.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">📋</div><h3>Document Control</h3><p>Bill of lading, manifests, customs declarations, DG declarations, phytosanitary certificates — full approval workflow.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">⚠️</div><h3>Incident Management</h3><p>Full incident lifecycle: raise, acknowledge, assign, resolve. Severity triage, audit trail, corrective action tracking.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🤖</div><h3>AI Recommendations</h3><p>Rules-based intelligence engine that monitors operational metrics and generates actionable recommendations.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">📊</div><h3>Analytics</h3><p>Throughput trends, turnaround analysis, berth efficiency, yard density, and crane productivity with date range filtering.</p></div>
    </div>
</div></section>
<section class="sp-section sp-section--cta"><div class="container sp-section--cta__inner">
    <h2>Ready to see it in action?</h2>
    <div class="sp-hero__actions">
        <a asp-controller="Auth" asp-action="Login" class="sp-btn sp-btn--primary sp-btn--lg">Try the Demo</a>
        <a asp-controller="Home" asp-action="Contact" class="sp-btn sp-btn--outline-light sp-btn--lg">Talk to Us</a>
    </div>
</div></section>
