@{ Layout = "_LayoutPublic"; ViewData["Title"] = "About SmartPort"; }
<section class="sp-hero sp-hero--sm"><div class="sp-hero__bg"></div>
    <div class="container sp-hero__inner"><h1 class="sp-hero__headline">About SmartPort</h1><p class="sp-hero__sub">An intelligent port operations platform built for South Africa's maritime industry.</p></div>
</section>
<section class="sp-section sp-section--white"><div class="container">
    <div class="sp-split">
        <div class="sp-split__text">
            <h2>Our Mission</h2>
            <p>SmartPort was founded to address the operational complexity facing South Africa's port and logistics sector. Ports like Durban, Cape Town, and Richards Bay are critical arteries for the southern African economy — yet many operational teams still rely on fragmented systems, manual processes, and delayed information flows.</p>
            <p>SmartPort provides the operational intelligence layer that connects vessel scheduling, container tracking, gate management, document compliance, and incident response into a single platform — giving every stakeholder the information they need, when they need it.</p>
        </div>
        <div class="sp-split__text">
            <h2>Built for SA Industry</h2>
            <p>Every workflow has been designed with the realities of Transnet Port Terminals, private terminal operators, freight forwarders, and the SARS/SAMSA regulatory environment in mind.</p>
            <p>Our platform is built on proven enterprise technology — ASP.NET Core 8, PostgreSQL, and a clean domain model — designed to integrate with existing TOS systems, AIS feeds, and customs platforms over time.</p>
        </div>
    </div>
</div></section>
<section class="sp-section sp-section--dark"><div class="container">
    <div class="sp-section__header"><h2>Technology Foundation</h2></div>
    <div class="sp-modules-grid">
        <div class="sp-module-card"><div class="sp-module-card__icon">⚙️</div><h3>ASP.NET Core 8</h3><p>Enterprise-grade .NET backend with MVC architecture, robust auth, and clean domain separation.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🗄️</div><h3>PostgreSQL 16</h3><p>Production-ready relational database with ACID compliance and excellent performance at scale.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🔐</div><h3>Role-Based Access</h3><p>ASP.NET Core Identity with 5 operational roles and policy-based authorization throughout.</p></div>
        <div class="sp-module-card"><div class="sp-module-card__icon">🐳</div><h3>Docker Ready</h3><p>Containerised deployment via Docker Compose. Runs on any cloud or on-premise Linux server.</p></div>
    </div>
</div></section>
<section class="sp-section sp-section--cta"><div class="container sp-section--cta__inner">
    <h2>Interested in a pilot?</h2><p>We are actively engaging port authorities, terminal operators, and logistics companies for our pilot programme.</p>
    <a asp-controller="Home" asp-action="Contact" class="sp-btn sp-btn--primary sp-btn--lg">Contact Our Team</a>
</div></section>
