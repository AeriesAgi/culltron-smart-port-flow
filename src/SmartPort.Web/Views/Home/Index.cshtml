@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Smart Port AI Operations Platform"; }
<section class="spx-hero spx-hero--cinematic">
  <div class="container spx-hero__grid">
    <div>
      <span class="spx-kicker">Enterprise AI · port logistics · synthetic demo data</span>
      <h1>Agentic AI for port logistics, queue execution, fleet coordination, and emissions-aware operations.</h1>
      <p class="spx-lead">Smart Port connects control-room decisions, fleet owners, and drivers through AI-assisted execution plans, app-based check-ins, fleet tracking, audit trails, and Gemini-powered operational reasoning.</p>
      <div class="spx-actions"><a class="sp-btn sp-btn--primary sp-btn--lg" href="/demo-access">Enter Demo</a><a class="sp-btn sp-btn--outline sp-btn--lg" href="/dashboard">Open Control Room</a><a class="sp-btn sp-btn--outline sp-btn--lg" href="/driver-app">View Driver App</a><a class="sp-btn sp-btn--outline sp-btn--lg" href="/fleet/tracker">View Fleet Tracker</a></div>
      <p class="spx-note">Gemini calls are action-triggered only; dashboard rendering uses deterministic calculations and cached demo state. Location is click-to-check-in only, not background tracking.</p>
    </div>
    <img src="/images/smart-port-hero.svg" alt="Smart Port AI control room original illustration" />
  </div>
</section>
<section class="container spx-section">
  <span class="spx-kicker">Complete operational loop</span>
  <h2>Video-ready proof points from public story to audited execution</h2>
  <div class="spx-module-grid spx-module-grid--features">
  @foreach (var item in new[] {
    ("Public story", "Product landing explains the pilot-ready operating loop for control rooms, fleets and drivers."),
    ("Demo login", "Role-based access separates judge, admin, fleet owner and driver demo paths."),
    ("Port Admin command centre", "Control-room dashboard manages queue state, incidents, driver check-ins and execution plans."),
    ("Gemini Operations Agent", "On-demand AI brief uses deterministic fallback and never runs on page load."),
    ("Execution plan", "Disruption context becomes truck, fleet-owner and driver actions with impact estimates."),
    ("Fleet owner action", "Fleet can request check-ins, send instructions, update status and review history."),
    ("Driver Companion tracking", "Driver check-ins update tracker state, queue ETA and audit trail."),
    ("Mobile API status", "Backend endpoints support APK, web companion and demo mobile workflows."),
    ("Driver confirmation", "Driver actions feed back into queue state and fleet/control-room timelines."),
    ("Updated queue state", "Dashboard reflects operational state changes after explicit actions."),
    ("Audit trail", "Every action is timestamped, sourced and visible for review."),
    ("Emissions report", "Idling and CO₂ impact stay linked to execution decisions.")
  }) { <article class="spx-module-card"><strong>@item.Item1</strong><p>@item.Item2</p></article> }
  </div>
</section>
<section class="container spx-section spx-visual-grid">
  <img src="/images/control-room-panel.svg" alt="AI control room visual"/>
  <div><span class="spx-kicker">Gemini + deterministic fallback</span><h2>Useful AI without quota burn</h2><p>Smart Port never calls Gemini just to load a page. Operators, fleet owners, drivers and judges trigger AI through deliberate actions such as Generate operations brief, Ask Copilot, Explain execution plan, Analyze check-in or optional TTS/semantic retrieval.</p><div class="spx-actions"><a class="sp-btn sp-btn--primary" href="/gemini-agent">Enterprise AI</a><a class="sp-btn sp-btn--outline" href="/execution">Execution Plans</a></div></div>
</section>
<section class="container spx-section spx-pilot"><span class="spx-kicker">Honest pilot integration path</span><h2>Connector-ready, not pretending to be live</h2><p>Smart Port uses synthetic demo data in this submission. It does not claim official port partnership, production WhatsApp approval, background tracking, or guaranteed preview Gemini features. TTS, embeddings, maps grounding and live connectors activate only when configured and quota allows.</p><a class="sp-btn sp-btn--outline" href="/enterprise-readiness">Enterprise readiness checklist</a></section>
