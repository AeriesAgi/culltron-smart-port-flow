@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "Culltron Smart Port Flow";
}

<!-- ─── Hero ──────────────────────────────────────────────────────────── -->
<section class="sp-hero">
    <div class="sp-hero__bg"></div>
    <div class="container sp-hero__inner">
        <div class="sp-hero__badge">Culltron Smart Port Flow · Agentic Operations Copilot</div>
        <h1 class="sp-hero__headline">
            Predict Congestion.<br>
            Command Flow.<br>
            Cut Emissions.
        </h1>
        <p class="sp-hero__sub">
            Culltron Smart Port Flow turns synthetic port telemetry into an enterprise AI command center for berth planning, gate queues, truck flow, energy disruption, emissions impact, and explainable operator action plans.
        </p>
        <div class="sp-hero__actions">
            <a asp-controller="Home" asp-action="Demo" class="sp-btn sp-btn--primary sp-btn--lg">Launch Demo Mission</a>
            <a asp-controller="Home" asp-action="Product" class="sp-btn sp-btn--outline-light sp-btn--lg">Explore Command Center</a>
        </div>
        <div class="sp-hero__stats">
            <div class="sp-hero__stat">
                <span class="sp-hero__stat-val">3 400+</span>
                <span class="sp-hero__stat-label">TEU Flow Simulated Daily</span>
            </div>
            <div class="sp-hero__stat">
                <span class="sp-hero__stat-val">8</span>
                <span class="sp-hero__stat-label">AI-Monitored Berths</span>
            </div>
            <div class="sp-hero__stat">
                <span class="sp-hero__stat-val">27%</span>
                <span class="sp-hero__stat-label">Potential Idling Reduction</span>
            </div>
            <div class="sp-hero__stat">
                <span class="sp-hero__stat-val">0</span>
                <span class="sp-hero__stat-label">Cloud AI Secrets Required</span>
            </div>
        </div>
    </div>
</section>

<!-- ─── Modules Overview ──────────────────────────────────────────────── -->
<section class="sp-section sp-section--white">
    <div class="container">
        <div class="sp-section__header">
            <h2>One Agentic Command Center. Every Port Constraint.</h2>
            <p>Competition-ready demo modules combine congestion intelligence, berth intelligence, truck-flow optimisation, energy disruption analysis, emissions scoring, simulations, recommendations, and decision audit history.</p>
        </div>
        <div class="sp-modules-grid">
            <div class="sp-module-card">
                <div class="sp-module-card__icon">⚓</div>
                <h3>Vessel &amp; Berth Management</h3>
                <p>Real-time vessel tracking, berth assignment, arrival/departure scheduling, and turnaround performance monitoring.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">📦</div>
                <h3>Container &amp; Yard Operations</h3>
                <p>Container tracking from gate-in to gate-out, dwell time alerts, yard block utilisation, and cargo classification.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">🚛</div>
                <h3>Gate &amp; Landside Flow</h3>
                <p>Truck appointment management, gate queue monitoring, OCR/RFID integration readiness, and bottleneck detection.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">📋</div>
                <h3>Document &amp; Compliance</h3>
                <p>Shipment document tracking, customs status workflows, overdue document alerts, and approval audit trails.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">⚠️</div>
                <h3>Incidents &amp; Alerts</h3>
                <p>Operational incident management with severity triage, assignment, resolution tracking, and alert acknowledgment.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">🤖</div>
                <h3>Copilot Recommendations</h3>
                <p>Local deterministic recommendations with severity, affected area, operational reason, suggested action, expected impact, confidence, energy and emissions context.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">📊</div>
                <h3>Analytics &amp; Reporting</h3>
                <p>Throughput trends, turnaround analysis, berth efficiency, dwell time, and delay cause breakdowns with date filtering.</p>
            </div>
            <div class="sp-module-card">
                <div class="sp-module-card__icon">🏢</div>
                <h3>Executive Dashboard</h3>
                <p>Consolidated KPI overview for decision-makers — port health, congestion, productivity and commercial performance.</p>
            </div>
        </div>
    </div>
</section>

<!-- ─── Value Proposition ─────────────────────────────────────────────── -->
<section class="sp-section sp-section--dark">
    <div class="container">
        <div class="sp-split">
            <div class="sp-split__text">
                <div class="sp-section__header sp-section__header--left">
                    <h2>Built for South Africa's Ports</h2>
                    <p>SmartPort is designed for the operational realities of Transnet Port Terminals, private terminal operators, freight forwarders, and logistics partners operating in South Africa's port ecosystem.</p>
                </div>
                <ul class="sp-checklist">
                    <li>Compatible with SARS Customs and SAMSA reporting workflows</li>
                    <li>Designed for DCT, MPT, Cape Town, PE, and Richards Bay environments</li>
                    <li>IMDG and dangerous goods workflow support</li>
                    <li>Role-based access for operators, partners, and executives</li>
                    <li>Integrates with AIS vessel data feeds (Phase 2)</li>
                    <li>Weather advisory integration (SAWS) (Phase 2)</li>
                    <li>ERP and TOS integration pathways documented</li>
                </ul>
                <a asp-controller="Home" asp-action="Contact" class="sp-btn sp-btn--primary">Talk to Our Team</a>
            </div>
            <div class="sp-split__visual">
                <div class="sp-dashboard-preview">
                    <div class="sp-dp__header">
                        <span class="sp-dp__dot sp-dp__dot--red"></span>
                        <span class="sp-dp__dot sp-dp__dot--yellow"></span>
                        <span class="sp-dp__dot sp-dp__dot--green"></span>
                        <span class="sp-dp__title">SmartPort Operations Dashboard</span>
                    </div>
                    <div class="sp-dp__content">
                        <div class="sp-dp__kpis">
                            <div class="sp-dp__kpi"><span class="sp-dp__val">3</span><span class="sp-dp__lbl">Vessels In Port</span></div>
                            <div class="sp-dp__kpi"><span class="sp-dp__val">82%</span><span class="sp-dp__lbl">Berth Utilisation</span></div>
                            <div class="sp-dp__kpi"><span class="sp-dp__val">2,847</span><span class="sp-dp__lbl">TEU Today</span></div>
                            <div class="sp-dp__kpi sp-dp__kpi--alert"><span class="sp-dp__val">7</span><span class="sp-dp__lbl">Active Alerts</span></div>
                        </div>
                        <div class="sp-dp__bar-chart">
                            <div class="sp-dp__bar" style="height:60%"></div>
                            <div class="sp-dp__bar" style="height:75%"></div>
                            <div class="sp-dp__bar" style="height:55%"></div>
                            <div class="sp-dp__bar" style="height:85%"></div>
                            <div class="sp-dp__bar" style="height:70%"></div>
                            <div class="sp-dp__bar" style="height:90%"></div>
                            <div class="sp-dp__bar sp-dp__bar--active" style="height:78%"></div>
                        </div>
                        <div class="sp-dp__vessels">
                            <div class="sp-dp__vessel sp-dp__vessel--ops">MSC SARACEN · Cargo Ops</div>
                            <div class="sp-dp__vessel sp-dp__vessel--berthed">CMA CGM CALLISTO · Berthed</div>
                            <div class="sp-dp__vessel sp-dp__vessel--anchor">EVER GREET · At Anchor ⚠</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── CTA ────────────────────────────────────────────────────────────── -->
<section class="sp-section sp-section--cta">
    <div class="container sp-section--cta__inner">
        <h2>Ready to transform your port operations?</h2>
        <p>Join the pilot programme. SmartPort is available for terminal operators, port authorities, and logistics partners.</p>
        <div class="sp-hero__actions">
            <a asp-controller="Home" asp-action="Demo" class="sp-btn sp-btn--primary sp-btn--lg">Request a Demo</a>
            <a asp-controller="Auth" asp-action="Login" class="sp-btn sp-btn--outline sp-btn--lg">Access Demo System</a>
        </div>
    </div>
</section>
