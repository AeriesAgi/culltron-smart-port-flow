@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "AI-Powered Smart Port Operations";
}
<section class="spx-hero spx-hero--cinematic" id="overview">
  <div class="spx-orb spx-orb--a"></div><div class="spx-orb spx-orb--b"></div>
  <div class="container spx-hero__grid">
    <div class="spx-hero__copy">
      <div class="spx-kicker">Culltron Smart Port Flow · Enterprise AI operations prototype</div>
      <h1>AI-Powered Smart Port Operations</h1>
      <p class="spx-altline">From Port Congestion to Driver Execution — in One AI Workflow</p>
      <p class="spx-lead">Culltron Smart Port Flow turns control-room signals into fleet-owner actions, driver instructions, WhatsApp check-ins, Android companion updates, and measurable idling/CO₂ impact.</p>
      <div class="spx-actions">
        <a href="/demo-access" class="sp-btn sp-btn--primary sp-btn--lg">Request Demo / Demo Access</a>
        <a href="#modules" class="sp-btn sp-btn--outline sp-btn--lg">View Platform Overview</a>
        <a href="/demo-access?next=/driver" class="sp-btn sp-btn--outline sp-btn--lg">Driver Companion Preview</a>
      </div>
      <p class="spx-note">Demo mode uses synthetic operational data. Gemini and Meta WhatsApp Cloud API activate only when server-side credentials are configured.</p>
    </div>
    <div class="spx-port-visual" aria-label="Smart Port operational workflow diagram">
      <div class="spx-scanline"></div>
      <svg class="spx-crane" viewBox="0 0 600 260" role="img" aria-label="Port cranes, ship, containers and truck route">
        <defs><linearGradient id="glow" x1="0" x2="1"><stop stop-color="#22d3ee"/><stop offset="1" stop-color="#14b8a6"/></linearGradient></defs>
        <path d="M40 210 H560" stroke="#1e3a5f" stroke-width="3"/>
        <path d="M88 204 V74 H255 L300 118" fill="none" stroke="#38bdf8" stroke-width="4" opacity=".85"/>
        <path d="M380 205 V56 H520 L560 104" fill="none" stroke="#2dd4bf" stroke-width="4" opacity=".85"/>
        <path d="M120 82 H245 M412 64 H514" stroke="#93c5fd" stroke-width="2" opacity=".8"/>
        <rect x="110" y="174" width="210" height="32" rx="8" fill="#0f2744" stroke="#38bdf8"/>
        <rect x="126" y="151" width="42" height="22" rx="3" fill="#22d3ee" opacity=".85"/><rect x="172" y="151" width="42" height="22" rx="3" fill="#14b8a6" opacity=".85"/><rect x="218" y="151" width="42" height="22" rx="3" fill="#60a5fa" opacity=".85"/>
        <rect x="408" y="179" width="74" height="26" rx="6" fill="#0f2744" stroke="#2dd4bf"/><circle cx="426" cy="211" r="8" fill="#67e8f9"/><circle cx="466" cy="211" r="8" fill="#67e8f9"/>
        <path class="spx-route-line" d="M95 126 C170 98, 253 125, 322 132 S450 116, 516 152" fill="none" stroke="url(#glow)" stroke-width="4" stroke-dasharray="10 12"/>
      </svg>
      <div class="spx-control-grid">
        @foreach (var node in new[] { ("Control Room", "Signal"), ("Execution Plan", "AI plan"), ("Fleet Owner", "Action"), ("Driver App", "Confirm"), ("WhatsApp Check-In", "STATUS / READY"), ("Impact + Audit", "CO₂ + timeline") })
        {
          <div class="spx-node"><span>@node.Item2</span><strong>@node.Item1</strong></div>
        }
      </div>
      <div class="spx-floating-card spx-floating-card--left"><strong>Gate pressure</strong><span>High · release in waves</span></div>
      <div class="spx-floating-card spx-floating-card--right"><strong>Truck SPQ-2026-0042</strong><span>Proceed to staging · ETA updating</span></div>
    </div>
  </div>
</section>

<section class="spx-section" id="loop">
  <div class="container">
    <div class="spx-section__head"><span class="spx-kicker">Operational loop</span><h2>One closed workflow from detection to audit</h2><p>Each action is designed to update shared backend state for the dashboard, fleet console, driver pages, mobile APIs and notification history.</p></div>
    <div class="spx-loop">
      @foreach (var step in new[]{("01","Detect congestion","Control-room signal and synthetic operational context."),("02","Generate execution plan","Truck-level plan with call-forward timing."),("03","Coordinate fleet owner","Console actions for staging, gate release and exceptions."),("04","Send driver instruction","Web, Android, in-app and WhatsApp-ready messaging."),("05","Driver confirms/checks in","STATUS, READY, ARRIVED_GATE and location check-ins."),("06","ETA/status updates","Queue state and driver screen refresh from the same service."),("07","Measure impact","Idling minutes and CO₂ estimates remain transparent."),("08","Record audit trail","Timeline and notification history preserve the decision path.")})
      {
        <article class="spx-loop-step"><span>@step.Item1</span><h3>@step.Item2</h3><p>@step.Item3</p></article>
      }
    </div>
  </div>
</section>

<section class="spx-section spx-section--deep" id="modules">
  <div class="container">
    <div class="spx-section__head"><span class="spx-kicker">Smart Port product modules</span><h2>Operational Modules</h2><p>Polished demo surfaces for the control room, fleet owner, driver and integration-readiness story.</p></div>
    <div class="spx-card-grid">
      @foreach (var card in new[]{("Control Room Dashboard","Congestion, berth, gate and emissions context.","/demo-access?next=/dashboard"),("Execution Plan Generator","Truck-level movement plan with reasons and audit.","/demo-access?next=/execution/plans"),("Fleet Owner Console","Queue, staging, LiveTest readiness and dispatch actions.","/demo-access?next=/fleet"),("Driver Queue Companion","Mobile-first instructions, confirmations and Copilot.","/demo-access?next=/driver"),("WhatsApp LiveTest / Demo Notifications","Simulated mode plus Meta Cloud API readiness.","/demo-access?next=/fleet/notifications"),("Android Driver Companion","Native Kotlin source ready for backend APIs.","/demo-access?next=/fleet/download-app"),("Data Sources & Integration Readiness","Honest IPMS/TOS/gate/fleet integration plan.","/demo-access?next=/fleet/data-sources"),("Gemini/Fallback Copilot","Scoped operational AI with deterministic fallback.","/demo-access?next=/Copilot")})
      {
        <a class="spx-product" href="@card.Item3"><span></span><h3>@card.Item1</h3><p>@card.Item2</p></a>
      }
    </div>
  </div>
</section>

<section class="spx-section" id="previews">
  <div class="container">
    <div class="spx-section__head"><span class="spx-kicker">Visual product preview</span><h2>Command-centre feel without unverified integration claims</h2><p>HTML/CSS preview panels mirror the working product surfaces without relying on external assets.</p></div>
    <div class="spx-preview-grid">
      <article class="spx-preview-panel"><div class="spx-panel-top"><strong>Fleet Dashboard</strong><span>Live queue</span></div><div class="spx-kpi-row"><b>12</b><b>4</b><b>31kg</b></div><p>High-risk truck queue, gate release plan, staging and WhatsApp readiness in one operator view.</p></article>
      <article class="spx-preview-panel"><div class="spx-panel-top"><strong>Driver Status</strong><span>Mobile</span></div><div class="spx-phone-mock"><b>Proceed to staging</b><span>Gate G4 · ETA 18 min</span><em>READY · ARRIVED_GATE · ISSUE</em></div></article>
      <article class="spx-preview-panel"><div class="spx-panel-top"><strong>WhatsApp + Audit</strong><span>Timeline</span></div><ul class="spx-mini-timeline"><li>Outbound instruction stored</li><li>Driver replied STATUS</li><li>Location check-in updated ETA</li></ul></article>
      <article class="spx-preview-panel"><div class="spx-panel-top"><strong>Execution Plan</strong><span>AI + fallback</span></div><p>Truck action cards explain why to hold, stage, release, reschedule or mark exception.</p><div class="spx-plan-bars"><span></span><span></span><span></span></div></article>
    </div>
  </div>
</section>

<section class="spx-section spx-section--deep">
  <div class="container spx-split">
    <div class="spx-glow-card"><span class="spx-kicker">Scoped AI</span><h2>Gemini-enhanced, fallback-safe Copilot</h2><p>Gemini enhances Smart Port explanations when configured with environment variables. Deterministic fallback keeps the workflow running when Gemini is unavailable.</p><p>Copilot is scoped to Smart Port operations: queue, gate, staging, fleet-owner action, driver instruction, impact and audit.</p><a href="/demo-access?next=/Copilot" class="sp-btn sp-btn--primary">Open SmartPort Copilot</a></div>
    <div class="spx-glow-card"><span class="spx-kicker">Driver coordination</span><h2>WhatsApp LiveTest + Android companion</h2><p>Demo Mode uses simulated WhatsApp. LiveTest uses Meta WhatsApp Cloud API when credentials and an approved driver are configured.</p><p>Drivers can reply <code>STATUS</code>, <code>HOW LONG</code>, <code>READY</code>, <code>ARRIVED_GATE</code> and share WhatsApp location check-ins. Android calls backend APIs and stores no Gemini or WhatsApp secret.</p><p>No SMS. No continuous GPS tracking claim.</p><a href="/demo-access?next=/fleet/settings" class="sp-btn sp-btn--outline">Check readiness cards</a></div>
  </div>
</section>

<section class="spx-section">
  <div class="container spx-split">
    <div><span class="spx-kicker">Integration readiness</span><h2>Honest pilot path</h2><p>The current demo uses synthetic operational data. A pilot can connect to IPMS, terminal systems, gate appointment systems, berth/yard feeds, fleet systems, WhatsApp Cloud API and GPS/telematics later where approved.</p><p>These are planned integration paths, not claims of live production port connectivity.</p></div>
    <div class="spx-metric-stack"><div><strong>Synthetic data</strong><span>Transparent demo baseline</span></div><div><strong>Connector-ready</strong><span>Environment-driven Gemini and WhatsApp setup</span></div><div><strong>Pilot governance</strong><span>Human-approved operational actions</span></div></div>
  </div>
</section>

<section class="spx-section spx-final">
  <div class="container"><span class="spx-kicker">Submission-ready demo</span><h2>Show the loop from signal to driver execution</h2><p>Open demo access, generate an execution plan, update a truck, send a simulated or LiveTest-ready notification, then verify the driver page, timeline, Android/mobile API and impact trail.</p><div class="spx-actions"><a href="/demo-access?next=/fleet" class="sp-btn sp-btn--primary sp-btn--lg">Fleet Dashboard</a><a href="/demo-access?next=/driver" class="sp-btn sp-btn--outline sp-btn--lg">Driver Queue Companion</a><a href="/demo-access?next=/Copilot" class="sp-btn sp-btn--outline sp-btn--lg">SmartPort Copilot</a></div></div>
</section>
