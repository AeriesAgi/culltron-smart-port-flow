@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Pricing"; }
<section class="spx-page-hero"><div class="container"><span class="spx-kicker">Enterprise pilot pricing</span><h1>Pricing is scoped around pilot goals</h1><p>Smart Port is presented as a pilot-ready enterprise AI operations prototype. Commercial terms depend on deployment, integrations, security review and support needs.</p></div></section>
<section class="spx-section spx-section--deep"><div class="container"><div class="spx-card-grid spx-card-grid--three">
@foreach (var tier in new[]{("Demo Evaluation","For judges and stakeholders reviewing the protected demo.","Role-based access, synthetic data, Gemini fallback, WhatsApp Demo Mode, Android source preview"),("Pilot Readiness","For a controlled port/fleet pilot with approved test drivers.","Environment-driven Gemini, WhatsApp LiveTest, data mapping, readiness scoring, audit review"),("Enterprise Deployment","For production-grade private cloud or port environment rollout.","Security review, custom integrations, support model, governance and operational SLAs")}){<article class="spx-product"><span></span><h3>@tier.Item1</h3><p>@tier.Item2</p><p>@tier.Item3</p></article>}
</div><div class="spx-actions spx-center"><a href="/demo-access" class="sp-btn sp-btn--primary sp-btn--lg">Request Demo</a><a href="/contact" class="sp-btn sp-btn--outline sp-btn--lg">Contact: available on request</a></div></div></section>
