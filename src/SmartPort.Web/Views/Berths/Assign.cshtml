@model SmartPort.Application.Interfaces.CreateBerthAssignmentDto
@{ ViewData["Title"] = "Assign Berth"; }
<div class="sp-form-page">
    <div class="sp-card sp-card--form">
        <div class="sp-card__header"><h3 class="sp-card__title">New Berth Assignment</h3></div>
        <form asp-action="Assign" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="sp-form__errors"></div>
            <div class="sp-form__grid sp-form__grid--2">
                <div class="sp-form__group">
                    <label asp-for="VesselId" class="sp-form__label">Vessel *</label>
                    <select asp-for="VesselId" class="sp-form__select">
                        <option value="">— Select vessel —</option>
                        @foreach (var v in (IEnumerable<SmartPort.Application.Interfaces.VesselListDto>)ViewBag.Vessels)
                        { <option value="@v.Id">@v.Name — @v.ShippingLine (@(v.VoyageNumber ?? "no voyage"))</option> }
                    </select>
                </div>
                <div class="sp-form__group">
                    <label asp-for="BerthId" class="sp-form__label">Berth *</label>
                    <select asp-for="BerthId" class="sp-form__select">
                        <option value="">— Select berth —</option>
                        @foreach (var b in (IEnumerable<SmartPort.Application.Interfaces.BerthStatusDto>)ViewBag.Berths)
                        {
                            var disabled = b.Status != SmartPort.Domain.Enums.BerthStatus.Available ? "disabled" : "";
                            <option value="@b.Id" @disabled>@b.Code — @b.Name (@b.Status)</option>
                        }
                    </select>
                </div>
                <div class="sp-form__group"><label asp-for="PlannedArrival" class="sp-form__label">Planned Arrival (UTC) *</label><input asp-for="PlannedArrival" class="sp-form__input" type="datetime-local"/></div>
                <div class="sp-form__group"><label asp-for="PlannedDeparture" class="sp-form__label">Planned Departure (UTC) *</label><input asp-for="PlannedDeparture" class="sp-form__input" type="datetime-local"/></div>
                <div class="sp-form__group"><label asp-for="PlannedDischarge" class="sp-form__label">Planned Discharge (TEU)</label><input asp-for="PlannedDischarge" class="sp-form__input" type="number" min="0"/></div>
                <div class="sp-form__group"><label asp-for="PlannedLoad" class="sp-form__label">Planned Load (TEU)</label><input asp-for="PlannedLoad" class="sp-form__input" type="number" min="0"/></div>
            </div>
            <div class="sp-form__footer">
                <a asp-action="Schedule" class="sp-btn sp-btn--outline">Cancel</a>
                <button type="submit" class="sp-btn sp-btn--primary">Create Assignment</button>
            </div>
        </form>
    </div>
</div>
