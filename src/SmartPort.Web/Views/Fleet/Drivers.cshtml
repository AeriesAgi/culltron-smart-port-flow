@using SmartPort.Application.DTOs
@model IReadOnlyList<DriverContactProfileDto>
@{ ViewData["Title"] = "Driver Companion Roster"; var status = ViewBag.WhatsAppStatus as WhatsAppConnectorStatusDto ?? new(); }
<section class="sp-page-hero fleet-hero"><div><span class="sp-badge sp-badge--ai">Driver companion readiness</span><h1>Driver Companion roster</h1><p>Manage driver identities, assigned trucks and notification readiness for the app-first operational loop. WhatsApp details are optional connector metadata for future sandbox/live-test pilots.</p></div><a class="sp-btn sp-btn--primary" href="/fleet/drivers/create">+ Add driver</a></section>
<div class="sp-card sp-mb"><strong>Optional connector mode:</strong> <span class="sp-badge sp-badge--ai">@status.Mode</span> @status.SafetyMessage</div>
<div class="sp-card"><table class="sp-table"><thead><tr><th>Driver</th><th>Truck</th><th>Fleet</th><th>Companion/contact</th><th>Live-test safety</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.DriverName</td><td>@d.AssignedTruckRegistration</td><td>@d.AssignedFleetOperatorName</td><td>@(string.IsNullOrWhiteSpace(d.NormalizedWhatsAppNumber)?"App/web companion only":$"Optional connector: {d.NormalizedWhatsAppNumber}")</td><td><span class="sp-badge sp-badge--@(d.IsLiveWhatsAppSafe?"success":"warning")">@(d.IsLiveWhatsAppSafe?"Optional LiveTest approved":"App/demo safe")</span></td></tr>}</tbody></table></div>
