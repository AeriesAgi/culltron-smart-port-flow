@{ ViewData["Title"] = "Android Companion"; var refs = ViewBag.DemoReferences as IReadOnlyList<string> ?? Array.Empty<string>(); var apkExists = ViewBag.ApkExists as bool? ?? false; }
<div class="sp-toolbar"><div><h1>Smart Port Driver Companion Android app</h1><p>Native Kotlin companion for driver queue status, confirmations, demo location check-ins and Smart Port Copilot.</p></div><a href="/driver" class="sp-btn sp-btn--outline">Open web companion</a></div>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>What the app does</h2><ul class="sp-checklist"><li>Fetches truck status from <code>/api/mobile/truck/status/{reference}</code></li><li>Shows queue number, ETA, gate, staging zone, status and latest instruction</li><li>Shows notification history returned by the backend</li><li>Posts driver confirmations and demo location check-ins</li><li>Calls backend Copilot endpoint; it stores no Gemini or WhatsApp secrets</li></ul></article><article class="sp-card"><h2>Backend URLs</h2><dl class="driver-dl"><dt>Default</dt><dd><code>https://smartport.culltron.app</code></dd><dt>Local emulator</dt><dd><code>https://10.0.2.2:5001</code> or the forwarded Codespaces URL</dd><dt>Local device</dt><dd>Use the LAN/deployed HTTPS URL that can reach the ASP.NET app</dd></dl></article></div>
<article class="sp-card"><h2>APK status</h2>@if(apkExists){<p>Debug APK is available.</p><a class="sp-btn sp-btn--primary" href="/downloads/SmartPortDriverCompanion.apk">Download APK</a>}else{<p class="sp-alert sp-alert--warning">APK not built yet. Android source is included under <code>/mobile/SmartPortDriverCompanion</code> and can be built in Android Studio.</p>}</article>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Demo references</h2><div class="ack-grid">@foreach(var r in refs){<a class="sp-btn sp-btn--outline" href="/truck/status/@r">@r</a>}</div></article><article class="sp-card"><h2>Android Studio build steps</h2><ol class="sp-steps"><li>Open <code>/mobile/SmartPortDriverCompanion</code> in Android Studio.</li><li>Let Gradle sync the Kotlin/Android project.</li><li>Run on emulator/device and set backend URL if needed.</li><li>Use <strong>Build &gt; Build APK(s)</strong>.</li><li>Optional CI output path: <code>wwwroot/downloads/SmartPortDriverCompanion.apk</code>.</li></ol><p>Future Play Store path: add release signing, privacy copy, authentication and CI-generated AAB/APK.</p></article></div>
