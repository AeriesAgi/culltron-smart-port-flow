@{ ViewData["Title"] = "Android Companion"; var refs = ViewBag.DemoReferences as IReadOnlyList<string> ?? Array.Empty<string>(); var apkExists = ViewBag.ApkExists as bool? ?? false; }
<div class="sp-toolbar"><div><span class="sp-badge sp-badge--ai">Android companion</span><h1>Smart Port Driver Companion</h1><p>Native Kotlin companion for driver queue status, confirmations, demo location check-ins and Smart Port Copilot.</p></div><a href="/driver" class="sp-btn sp-btn--outline">Open web companion</a></div>
<div class="sp-grid sp-grid--2"><article class="sp-card sp-premium-panel"><h2>Companion capabilities</h2><ul class="sp-checklist"><li>Fetches truck status from <code>/api/mobile/truck/status/{reference}</code></li><li>Shows queue number, ETA, gate, staging zone, status and latest instruction</li><li>Shows notification history returned by the backend</li><li>Posts confirmations, driver commands and demo location check-ins</li><li>Calls backend Copilot endpoint; it stores no Gemini or WhatsApp secrets</li><li>Uses configurable backend URL with <code>https://smartport.culltron.app</code> as deployment default</li></ul></article><article class="sp-card"><h2>Backend URLs</h2><dl class="driver-dl"><dt>Default</dt><dd><code>https://smartport.culltron.app</code></dd><dt>Local emulator</dt><dd><code>https://10.0.2.2:5001</code> or the forwarded development HTTPS URL</dd><dt>Local device</dt><dd>Use the LAN/deployed HTTPS URL that can reach the ASP.NET app</dd></dl></article></div>
<article class="sp-card sp-download-panel"><div><span class="sp-badge sp-badge--green">Source ready</span><h2>APK availability</h2>@if(apkExists){<p>Debug APK is available for demo installation.</p><a class="sp-btn sp-btn--primary" href="/downloads/SmartPortDriverCompanion.apk">Download APK</a>}else{<p class="sp-alert sp-alert--info">Android companion source is ready. APK can be built automatically via the Android APK workflow or from Android Studio.</p><p class="sp-muted">The web application remains deployable without an Android SDK in the hosting environment; CI uploads the debug APK artifact and it can be copied into wwwroot/downloads before deployment.</p>}</div></article>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Demo references</h2><p>Use one of these references in the Android app or mobile API smoke tests:</p><div class="ack-grid">@foreach(var r in refs){<code class="sp-chip">@r</code>}</div></article><article class="sp-card"><h2>Build from source</h2><ol class="sp-steps"><li>Run the GitHub Actions Android APK workflow, or open <code>mobile/SmartPortDriverCompanion</code> in Android Studio.</li><li>Set backend URL if needed; leave the default for <code>smartport.culltron.app</code>.</li><li>Build the debug APK.</li><li>Copy <code>app/build/outputs/apk/debug/app-debug.apk</code> to <code>src/SmartPort.Web/wwwroot/downloads/SmartPortDriverCompanion.apk</code> before deployment if you want the web download button.</li><li>Install the APK on a test device and enter a truck reference.</li></ol><p class="sp-muted">The Android app duplicates no backend AI logic and contains no provider tokens.</p></article></div>
