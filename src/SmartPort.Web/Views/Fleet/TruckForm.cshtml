@using SmartPort.Application.DTOs
@model SaveFleetQueueTruckRequestDto
@{ ViewData["Title"] = "Fleet Truck / Job Assignment"; var fleets = ViewBag.FleetOperators as IReadOnlyList<FleetOperatorDto> ?? Array.Empty<FleetOperatorDto>(); }
<section class="sp-page-hero fleet-hero"><div><span class="sp-badge sp-badge--manual">Manual</span><h1>Add/edit truck job</h1></div></section>
<form method="post" action="/fleet/trucks/save" class="sp-card sp-card--form"><div class="sp-form__grid sp-form__grid--2"><select class="sp-form__select" name="FleetOperatorId">@foreach(var f in fleets){<option value="@f.Id">@f.Name</option>}</select><input class="sp-form__input" name="TruckRegistration" placeholder="Truck registration" required/><input class="sp-form__input" name="AssignedDriverName" placeholder="Driver"/><input class="sp-form__input" name="BookingReference" placeholder="Booking/reference"/><input class="sp-form__input" name="ContainerReference" placeholder="Container/job"/><input class="sp-form__input" name="AssignedGate" placeholder="Gate"/><input class="sp-form__input" name="BerthYardStagingZone" placeholder="Staging area"/></div><button class="sp-btn sp-btn--primary">Save truck/job</button></form>
