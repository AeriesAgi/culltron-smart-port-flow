@using SmartPort.Application.DTOs
@model IReadOnlyList<FleetTruckDto>
@{
    ViewData["Title"] = "Fleet / Driver Tracker";
    var active = Model.Count(t => t.CurrentStatus != QueueTruckStatus.Completed);
    var delayed = Model.Count(t => t.DelayRisk is QueueDelayRisk.High or QueueDelayRisk.Critical || t.CurrentStatus is QueueTruckStatus.Delayed or QueueTruckStatus.Rescheduled);
    var checkedIn = Model.Count(t => t.LastLocationCheckIn != null || !string.IsNullOrWhiteSpace(t.LastKnownLocationLabel));
}
<div class="sp-toolbar"><div><span class="sp-badge sp-badge--green">Driver Companion App primary channel</span><h1>Fleet / Driver Tracker</h1><p>The Driver Companion App acts as the live fleet tracking channel through user-triggered status, check-in, and location updates. No background tracking or external map credentials are required.</p></div><div class="sp-actions"><a class="sp-btn sp-btn--primary" href="/fleet/download-app">Driver Companion App</a><a class="sp-btn sp-btn--outline" href="/driver/demo">Open Web Companion</a></div></div>
<div class="sp-kpi-grid"><div class="sp-kpi-card"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@active</div><div class="sp-kpi-card__label">Active trucks tracked</div><div class="sp-kpi-card__sub">App/web/mobile API updates</div></div></div><div class="sp-kpi-card sp-kpi-card--warn"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@delayed</div><div class="sp-kpi-card__label">Delayed / high risk</div><div class="sp-kpi-card__sub">Needs fleet attention</div></div></div><div class="sp-kpi-card"><div class="sp-kpi-card__body"><div class="sp-kpi-card__value">@checkedIn</div><div class="sp-kpi-card__label">Latest check-ins</div><div class="sp-kpi-card__sub">User-triggered only</div></div></div></div>
<article class="sp-card sp-mt"><div class="sp-card__header"><div><h2>Driver tracker table</h2><p>Queue, ETA, idling and CO₂ impact recalculate after check-ins and driver actions.</p></div><a class="sp-btn sp-btn--primary" href="/Copilot?prompt=Which%20tracked%20drivers%20need%20attention%3F">Ask Copilot</a></div><div class="sp-table-wrap"><table class="sp-table"><thead><tr><th>Truck / driver</th><th>Status</th><th>Gate / zone</th><th>Queue & ETA</th><th>Risk</th><th>Last action / check-in</th><th>Location</th><th>Source</th><th></th></tr></thead><tbody>@foreach (var t in Model.OrderByDescending(t => t.DelayRisk).ThenBy(t => t.QueueNumber)){ var last = t.Timeline.OrderByDescending(x=>x.Timestamp).FirstOrDefault(); <tr><td><strong>@t.BookingReference</strong><br/><span>@t.TruckRegistration · @t.DriverName</span><br/><small>@t.FleetOperatorName</small></td><td>@t.CurrentStatus</td><td>@t.AssignedGate<br/><small>@t.BerthYardStagingZone</small></td><td>#@t.QueueNumber<br/><small>@t.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</small></td><td><span class="sp-badge sp-badge--@(t.DelayRisk is QueueDelayRisk.High or QueueDelayRisk.Critical ? "warning" : "green")">@t.DelayRisk</span></td><td>@(last?.Note ?? "No action yet")<br/><small>@(last?.Timestamp.ToLocalTime().ToString("g") ?? "—")</small></td><td>@t.LastKnownLocationLabel@if(t.LastLocationCheckIn != null){<br/><small>@t.LastLocationCheckIn.Latitude, @t.LastLocationCheckIn.Longitude</small>}</td><td>@(t.LastLocationCheckIn?.Source.ToString() ?? t.Source.ToString())</td><td><a class="sp-btn sp-btn--sm sp-btn--outline" href="/fleet/trucks/@t.BookingReference">Detail</a></td></tr>}</tbody></table></div></article>
<article class="sp-card sp-mt"><h2>Map connector ready</h2><p>Clean card/table tracking is active now. A future map provider can subscribe to the same Driver Companion App / Mobile API check-ins without adding provider credentials to this demo.</p></article>
