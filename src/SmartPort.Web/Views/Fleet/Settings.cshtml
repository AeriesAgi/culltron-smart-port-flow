@using SmartPort.Application.DTOs
@using SmartPort.Infrastructure.Services
@{
    ViewData["Title"] = "Fleet Settings";
    var status = ViewBag.WhatsAppStatus as WhatsAppConnectorStatusDto ?? new();
    var gemini = ViewBag.GeminiStatus as AgentModeStatus ?? new();
}
<div class="sp-toolbar"><div><h1>Integration settings</h1><p>Safe readiness view for Gemini Copilot and Meta WhatsApp Cloud API LiveTest. Secrets are never displayed.</p></div><a href="/fleet" class="sp-btn sp-btn--outline">Fleet dashboard</a></div>
@if (TempData["GeminiTest"] is string test){<div class="sp-alert sp-alert--success"><strong>Copilot test response:</strong> @test</div>}
<div class="sp-grid sp-grid--2">
  <article class="sp-card"><h2>Gemini / Smart Port Copilot</h2><dl class="driver-dl"><dt>Gemini enabled</dt><dd>@(gemini.GeminiEnabled ? "Yes" : "No")</dd><dt>Gemini API key configured</dt><dd>@(gemini.GeminiConfigured ? "Yes" : "No")</dd><dt>Current AI mode</dt><dd>@gemini.CurrentMode</dd><dt>Status</dt><dd>@gemini.GeminiStatus</dd><dt>Fallback available</dt><dd>Yes — deterministic Smart Port fallback remains on</dd><dt>Smart Port Copilot</dt><dd>Available for dashboard, fleet, driver and mobile API questions</dd><dt>Mobile Copilot endpoints</dt><dd>POST /api/mobile/copilot/driver · POST /api/mobile/copilot/fleet</dd></dl><form method="post" action="/fleet/settings/test-gemini"><button class="sp-btn sp-btn--primary">Test Gemini Copilot</button></form><p class="sp-muted">Configure with GEMINI_API_KEY, Gemini__Enabled, Gemini__Mode and Gemini__Model. Key values are not shown or sent to the browser.</p></article>
  <article class="sp-card"><h2>WhatsApp Cloud API readiness</h2><dl class="driver-dl"><dt>Mode</dt><dd>@status.Mode</dd><dt>SMARTPORT_WHATSAPP_ENABLED</dt><dd>@(status.Enabled ? "true" : "false / missing")</dd><dt>Access token configured</dt><dd>@(status.AccessTokenConfigured ? "Yes" : "No")</dd><dt>Phone number ID configured</dt><dd>@(status.PhoneNumberIdConfigured ? "Yes" : "No")</dd><dt>Business account ID configured</dt><dd>@(status.BusinessAccountIdConfigured ? "Yes" : "No")</dd><dt>Verify token configured</dt><dd>@(status.VerifyTokenConfigured ? "Yes" : "No")</dd><dt>Graph version</dt><dd>@status.GraphVersion</dd><dt>Public base URL</dt><dd>@(string.IsNullOrWhiteSpace(status.PublicBaseUrl) ? "Not configured" : status.PublicBaseUrl)</dd><dt>Webhook callback URL</dt><dd><code>@status.WebhookCallbackUrl</code></dd><dt>LiveTest allowed</dt><dd>@(status.LiveSendingAllowed ? "Yes" : "No")</dd></dl><p>@status.SafetyMessage</p></article>
</div>
<article class="sp-card"><h2>LiveTest readiness checks</h2><div class="sp-modules-grid">@foreach(var check in status.LiveTestReadinessChecks){<div class="notification-row"><span class="sp-badge @(check.Contains("missing") || check.Contains("not") || check.StartsWith("No ") ? "sp-badge--warning" : "sp-badge--green")">@(check.Contains("missing") || check.Contains("not") || check.StartsWith("No ") ? "Action" : "Ready")</span><p>@check</p></div>}</div></article>
<article class="sp-card"><h2>Meta WhatsApp LiveTest setup</h2><ol class="sp-steps"><li>Configure Meta WhatsApp Cloud API credentials as environment variables.</li><li>Set <code>SMARTPORT_PUBLIC_BASE_URL</code> to the public deployed URL.</li><li>Set callback URL to <code>{SMARTPORT_PUBLIC_BASE_URL}/webhooks/whatsapp</code>.</li><li>Set the Meta verify token to match <code>SMARTPORT_WHATSAPP_VERIFY_TOKEN</code>.</li><li>Add a test driver with full country code, for example <code>+27...</code>.</li><li>Mark the driver active, Test Approved, and WhatsApp Consent Confirmed.</li><li>Assign the driver to a truck/job.</li><li>Switch <code>SMARTPORT_WHATSAPP_MODE=LiveTest</code>.</li><li>Send a LiveTest instruction from truck detail.</li><li>Driver replies STATUS, HOW LONG, BREAK 15, READY, ARRIVED_GATE, or shares a WhatsApp location check-in.</li><li>Fleet dashboard, driver page, notification history, mobile API, and Android app update from backend state.</li></ol><p class="sp-muted">Demo mode works without paid providers. LiveTest sends only to approved/consented test drivers. No SMS and no hardcoded secrets.</p></article>
