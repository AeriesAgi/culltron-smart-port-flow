@using SmartPort.Application.DTOs
@model ExecutionPlanDto
@{ ViewData["Title"] = "Execution Plan"; }
<div class="sp-toolbar"><div><span class="sp-badge sp-badge--ai">Operational Execution Loop · @Model.Status</span><h1>@Model.ScenarioName</h1><p>@Model.Explanation</p></div><a href="/execution/plans" class="sp-btn sp-btn--outline">All plans</a></div>
@if (TempData["Success"] is string ok){<div class="sp-alert sp-alert--success">@ok</div>}@if (TempData["Warning"] is string warn){<div class="sp-alert sp-alert--warning">@warn</div>}
<section class="sp-card sp-premium-panel sp-mb"><div class="sp-grid sp-grid--4"><div><span class="sp-muted">Status</span><strong class="sp-kpi-number">@Model.Status</strong><span>@Model.PortStage</span></div><div><span class="sp-muted">Idling avoided</span><strong class="sp-kpi-number">@Model.ExpectedIdlingMinutesAvoided</strong><span>minutes</span></div><div><span class="sp-muted">CO₂ avoided</span><strong class="sp-kpi-number">@Model.ExpectedCo2KgAvoided.ToString("N1")</strong><span>kg</span></div><div><span class="sp-muted">Diesel saved</span><strong class="sp-kpi-number">@Model.EstimatedDieselLitresSaved.ToString("N1")</strong><span>litres</span></div></div><p class="sp-alert sp-alert--info">Synthetic demo estimate for decision support. Source: @Model.ModelSource. Confidence: @Model.ConfidenceScore.ToString("P0").</p></section>
<section class="sp-card sp-ops-panel sp-mb"><div class="sp-card__header"><div><span class="sp-badge sp-badge--green">Human approval required</span><h2>Plan command actions</h2></div><a class="sp-btn sp-btn--sm sp-btn--outline" href="/fleet/tracker">Open tracker</a></div><div class="ack-grid"><form method="post" action="/execution/plans/@Model.PlanId/approve"><button class="sp-btn sp-btn--success">Approve plan</button></form><form method="post" action="/execution/plans/@Model.PlanId/dispatch"><button class="sp-btn sp-btn--primary">Dispatch to fleet + drivers</button></form><form method="post" action="/execution/plans/@Model.PlanId/complete"><button class="sp-btn sp-btn--outline">Complete plan</button></form><form method="post" action="/execution/plans/@Model.PlanId/exception"><button class="sp-btn sp-btn--warning">Flag exception</button></form><a class="sp-btn sp-btn--outline" href="/gemini-agent">Generate Gemini operations brief</a></div></section>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Fleet owner instructions</h2><ul class="sp-list">@foreach(var i in Model.FleetOwnerInstructions){<li>@i</li>}</ul></article><article class="sp-card"><h2>Driver instruction set</h2><ul class="sp-list">@foreach(var i in Model.DriverInstructionSet){<li>@i</li>}</ul></article></div>
<section class="sp-card sp-mt"><div class="sp-card__header"><div><span class="sp-badge sp-badge--green">Truck action timeline</span><h2>Affected trucks and state-changing actions</h2></div><a href="/fleet" class="sp-btn sp-btn--sm sp-btn--primary">Open fleet console</a></div><div class="sp-plan-timeline">@foreach(var action in Model.TruckActions){<article class="sp-plan-action"><div class="sp-plan-index">@((Model.TruckActions.IndexOf(action)+1).ToString("00"))</div><div><div class="sp-comms-head"><strong>@action.TruckRegistration</strong><span class="sp-badge sp-badge--ai">@action.ActionType</span><small>@action.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</small></div><p>@action.Reason</p><p class="driver-instruction">@action.NotificationText</p><div class="sp-comms-meta"><span>@action.TruckReference</span><span>@action.IdlingMinutesAvoided min idling avoided</span><span>@action.Co2KgAvoided.ToString("N1") kg CO₂</span></div><div class="ack-grid"><form method="post" action="/execution/plans/@Model.PlanId/truck-action"><input type="hidden" name="truckReference" value="@action.TruckReference"/><button name="actionType" value="RequestLocation" class="sp-btn sp-btn--outline">Request check-in</button><button name="actionType" value="MoveToStaging" class="sp-btn sp-btn--outline">Move to staging</button><button name="actionType" value="ProceedToGate" class="sp-btn sp-btn--primary">Release to gate</button><button name="actionType" value="Reschedule" class="sp-btn sp-btn--warning">Reschedule</button><button name="actionType" value="MarkException" class="sp-btn sp-btn--warning">Mark exception</button></form></div></div></article>}</div></section>
<section class="sp-card sp-mt"><h2>Audit trail</h2>@foreach(var entry in Model.AuditEntries.OrderByDescending(e => e.Timestamp)){<div class="timeline-step"><strong>@entry.EventType</strong><span>@entry.Timestamp.ToLocalTime().ToString("g")</span><p>@entry.PublicSafeNote</p><small>@entry.Actor · @entry.Source</small></div>}</section>
