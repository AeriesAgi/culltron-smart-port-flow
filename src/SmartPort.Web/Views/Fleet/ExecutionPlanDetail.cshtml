@using SmartPort.Application.DTOs
@model ExecutionPlanDto
@{ ViewData["Title"] = "Execution Plan"; }
<div class="sp-toolbar"><div><span class="sp-badge sp-badge--ai">Operational Execution Loop</span><h1>@Model.ScenarioName</h1><p>@Model.Explanation</p></div><a href="/execution/plans" class="sp-btn sp-btn--outline">All plans</a></div>
<section class="sp-card sp-premium-panel sp-mb"><div class="sp-grid sp-grid--4"><div><span class="sp-muted">Idling avoided</span><strong class="sp-kpi-number">@Model.ExpectedIdlingMinutesAvoided</strong><span>minutes</span></div><div><span class="sp-muted">CO₂ avoided</span><strong class="sp-kpi-number">@Model.ExpectedCo2KgAvoided.ToString("N1")</strong><span>kg</span></div><div><span class="sp-muted">Delay reduction</span><strong class="sp-kpi-number">@Model.ExpectedDelayReductionMinutes</strong><span>minutes</span></div><div><span class="sp-muted">Confidence</span><strong class="sp-kpi-number">@Model.ConfidenceScore.ToString("P0")</strong><span>plan score</span></div></div></section>
<section class="sp-card"><div class="sp-card__header"><div><span class="sp-badge sp-badge--green">Truck action timeline</span><h2>Plan actions</h2></div><a href="/fleet" class="sp-btn sp-btn--sm sp-btn--primary">Open fleet console</a></div><div class="sp-plan-timeline">@foreach(var action in Model.TruckActions){<article class="sp-plan-action"><div class="sp-plan-index">@((Model.TruckActions.IndexOf(action)+1).ToString("00"))</div><div><div class="sp-comms-head"><strong>@action.TruckRegistration</strong><span class="sp-badge sp-badge--ai">@action.ActionType</span><small>@action.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</small></div><p>@action.Reason</p><p class="driver-instruction">@action.NotificationText</p><div class="sp-comms-meta"><span>@action.TruckReference</span><span>@action.IdlingMinutesAvoided min idling avoided</span><span>@action.Co2KgAvoided.ToString("N1") kg CO₂</span></div><div class="ack-grid">@foreach(var next in action.AllowedNextActions){<span class="sp-chip">@next</span>}</div></div></article>}</div></section>
<section class="sp-card"><h2>Audit trail</h2>@foreach(var entry in Model.AuditEntries.OrderByDescending(e => e.Timestamp)){<div class="timeline-step"><strong>@entry.EventType</strong><span>@entry.Timestamp.ToLocalTime().ToString("g")</span><p>@entry.PublicSafeNote</p><small>@entry.Actor · @entry.Source</small></div>}</section>
