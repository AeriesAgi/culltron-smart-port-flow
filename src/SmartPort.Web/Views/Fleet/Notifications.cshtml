@model IReadOnlyList<SmartPort.Application.DTOs.DriverNotificationDto>
@using SmartPort.Application.DTOs
@{ ViewData["Title"] = "Notifications"; var refs = ViewBag.DemoReferences as IReadOnlyList<string> ?? Array.Empty<string>(); var selected = ViewBag.SelectedReference as string ?? refs.FirstOrDefault() ?? "SPQ-2026-0042"; var status = ViewBag.WhatsAppStatus as WhatsAppConnectorStatusDto ?? new(); }
<div class="sp-toolbar"><div><span class="sp-badge sp-badge--ai">Driver communication audit</span><h1>Driver communication timeline</h1><p>Driver Companion App, in-app, mobile API and optional connector events are stored with masked recipient data.</p></div><a href="/fleet" class="sp-btn sp-btn--outline">Fleet dashboard</a></div>
<section class="sp-card sp-mb"><span class="sp-badge sp-badge--muted">Optional Connector</span><h2>WhatsApp connector mode</h2><p><strong>@status.Mode</strong> · Enabled: <strong>@status.Enabled</strong> · Credentials configured: <strong>@status.CredentialsConfigured</strong> · Live sending allowed: <strong>@status.LiveSendingAllowed</strong></p><p>Optional connector-ready WhatsApp Cloud API integration for future pilots/live-test messaging.</p><p>@status.SafetyMessage</p><p>Webhook callback: <code>@status.WebhookCallbackUrl</code></p></section><form method="get" class="sp-card sp-form-inline sp-mb"><select class="sp-form__select" name="reference">@foreach(var r in refs){<option selected="@(r==selected)">@r</option>}</select><button class="sp-btn sp-btn--primary">Load history</button></form>
<article class="sp-card"><div class="sp-card__header"><h2>Communication timeline for @selected</h2><a class="sp-btn sp-btn--sm sp-btn--outline" href="/fleet/trucks/@selected">Open truck console</a></div>@if(!Model.Any()){<div class="sp-empty">No notification history yet. Send an in-app alert or optional connector message from the truck console.</div>}else{<div class="sp-comms-timeline">@foreach(var n in Model.OrderByDescending(n=>n.Timestamp)){<div class="sp-comms-item"><div class="sp-comms-dot"></div><div class="sp-comms-body"><div class="sp-comms-head"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><small>@n.Timestamp.ToLocalTime().ToString("g")</small></div><p>@n.Message</p><div class="sp-comms-meta"><span>@n.RecipientName</span><span>@n.EventType</span><span>@n.Source</span>@if(!string.IsNullOrWhiteSpace(n.ExternalMessageId)){<span>Meta ID: @n.ExternalMessageId</span>}</div></div></div>}</div>}</article>
