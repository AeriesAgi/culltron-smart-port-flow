@model IReadOnlyList<SmartPort.Application.DTOs.DriverNotificationDto>
@{ ViewData["Title"] = "Notifications"; var refs = ViewBag.DemoReferences as IReadOnlyList<string> ?? Array.Empty<string>(); var selected = ViewBag.SelectedReference as string ?? refs.FirstOrDefault() ?? "SPQ-2026-0042"; }
<div class="sp-toolbar"><div><span class="sp-badge sp-badge--ai">Demo + LiveTest audit</span><h1>WhatsApp and driver notification timeline</h1><p>Inbound, outbound, simulated and LiveTest-safe notification events are stored with masked recipient data.</p></div><a href="/fleet" class="sp-btn sp-btn--outline">Fleet dashboard</a></div>
<form method="get" class="sp-card sp-form-inline sp-mb"><select class="sp-form__select" name="reference">@foreach(var r in refs){<option selected="@(r==selected)">@r</option>}</select><button class="sp-btn sp-btn--primary">Load history</button></form>
<article class="sp-card"><div class="sp-card__header"><h2>Communication timeline for @selected</h2><a class="sp-btn sp-btn--sm sp-btn--outline" href="/fleet/trucks/@selected">Open truck console</a></div>@if(!Model.Any()){<div class="sp-empty">No notification history yet. Send an in-app alert or simulated WhatsApp from the truck console.</div>}else{<div class="sp-comms-timeline">@foreach(var n in Model.OrderByDescending(n=>n.Timestamp)){<div class="sp-comms-item"><div class="sp-comms-dot"></div><div class="sp-comms-body"><div class="sp-comms-head"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><small>@n.Timestamp.ToLocalTime().ToString("g")</small></div><p>@n.Message</p><div class="sp-comms-meta"><span>@n.RecipientName</span><span>@n.EventType</span><span>@n.Source</span>@if(!string.IsNullOrWhiteSpace(n.ExternalMessageId)){<span>Meta ID: @n.ExternalMessageId</span>}</div></div></div>}</div>}</article>
