@using SmartPort.Application.DTOs
@model FleetTruckDto
@{
    ViewData["Title"] = $"Truck {Model.TruckRegistration}";
    var wa = ViewBag.WhatsAppStatus as WhatsAppConnectorStatusDto ?? new();
    string disabledReason = wa.Mode is not (WhatsAppMode.LiveTest or WhatsAppMode.Live) ? "WhatsApp mode is not LiveTest/Live" : !wa.Enabled ? "WhatsApp not enabled" : !wa.AccessTokenConfigured ? "Access token missing" : !wa.PhoneNumberIdConfigured ? "Phone number ID missing" : !Model.DriverContact.IsActive ? "Driver not active" : !Model.DriverContact.TestApproved ? "Driver not Test Approved" : !Model.DriverContact.WhatsAppConsentConfirmed ? "WhatsApp Consent Confirmed false" : string.IsNullOrWhiteSpace(Model.DriverContact.NormalizedWhatsAppNumber) || !Model.DriverContact.NormalizedWhatsAppNumber.StartsWith("+") ? "Invalid WhatsApp number" : Model.DriverContact.IsDemoSeedRecord ? "Seeded demo driver/contact" : string.Empty;
    var liveDisabled = !string.IsNullOrWhiteSpace(disabledReason);
}
<div class="sp-toolbar"><div><h1>@Model.TruckRegistration operations console</h1><p>@Model.DriverName · @Model.FleetOperatorName · @Model.BookingReference</p></div><div class="sp-actions"><a href="/driver/status/@Model.BookingReference" class="sp-btn sp-btn--primary">Open Driver Companion</a><a href="/fleet/tracker" class="sp-btn sp-btn--outline">Fleet Tracker</a></div></div>
@if (TempData["Success"] is string ok){<div class="sp-alert sp-alert--success">@ok</div>}@if (TempData["Warning"] is string warn){<div class="sp-alert sp-alert--warning">@warn</div>}@if (TempData["CopilotAnswer"] is string answer){<div class="sp-alert sp-alert--success"><strong>Copilot:</strong> @answer</div>}
<div class="sp-grid sp-grid--2"><article class="sp-card"><span class="sp-badge sp-badge--ai">Synthetic Data · Gemini/Fallback ready</span><h2>Current AI movement instruction</h2><p class="driver-instruction">@Model.CurrentInstruction.Instruction</p><p>@Model.CurrentInstruction.Explanation</p><dl class="driver-dl"><dt>Reason</dt><dd>@Model.CurrentInstruction.Reason</dd><dt>Status</dt><dd>@Model.CurrentStatus</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Call-forward</dt><dd>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</dd><dt>Idling avoided</dt><dd>@Model.EstimatedIdlingMinutesAvoided min</dd><dt>CO₂ avoided</dt><dd>@Model.EstimatedCo2KgAvoided.ToString("N1") kg</dd></dl></article><article class="sp-card"><h2>Driver / appointment</h2><dl class="driver-dl"><dt>Contact readiness</dt><dd>@Model.DriverContact.ValidationMessage</dd><dt>Primary channel</dt><dd>Driver Companion App / Web Companion / Mobile API</dd><dt>Container/job</dt><dd>@Model.ContainerReference / @Model.JobReference</dd><dt>Appointment</dt><dd>@Model.AppointmentTime.ToLocalTime().ToString("f")</dd><dt>Queue</dt><dd>@Model.QueueNumber</dd><dt>Gate & zone</dt><dd>@Model.AssignedGate · @Model.BerthYardStagingZone</dd><dt>Latest app check-in</dt><dd>@(Model.LastLocationCheckIn?.Timestamp.ToLocalTime().ToString("g") ?? "No check-in yet")</dd><dt>Last location</dt><dd>@Model.LastKnownLocationLabel @if(Model.LastLocationCheckIn != null){<span>(@Model.LastLocationCheckIn.Latitude, @Model.LastLocationCheckIn.Longitude)</span>}</dd></dl><div class="qr-reference">QR / gate ref: @Model.BookingReference</div></article></div>

<article class="sp-card sp-mt"><span class="sp-badge sp-badge--muted">Optional Connector</span><h2>WhatsApp Cloud API readiness</h2><div class="sp-grid sp-grid--4"><p><strong>Mode:</strong> @wa.Mode</p><p><strong>Verify token:</strong> @(wa.VerifyTokenConfigured ? "Yes" : "No")</p><p><strong>Access token:</strong> @(wa.AccessTokenConfigured ? "Yes" : "No")</p><p><strong>Phone number ID:</strong> @(wa.PhoneNumberIdConfigured ? "Yes" : "No")</p></div><p><strong>Callback URL:</strong> <code>@wa.WebhookCallbackUrl</code></p><p><strong>Send readiness:</strong> @(wa.LiveSendingAllowed ? "Send Ready" : wa.VerifyTokenConfigured && wa.PublicBaseUrlConfigured ? "Webhook Ready" : wa.CredentialsConfigured ? "Configured" : "Sandbox")</p><p>Optional connector-ready WhatsApp Cloud API integration for future pilots/live-test messaging.</p><p>@wa.SafetyMessage</p></article>
<article class="sp-card sp-ops-panel"><div class="sp-card__header"><div><span class="sp-badge sp-badge--ai">Operator panel</span><h2>Fleet owner actions</h2></div><a class="sp-btn sp-btn--sm sp-btn--outline" href="/driver/status/@Model.BookingReference">View Driver Page</a></div><div class="ack-grid"><form method="post" action="/fleet/trucks/@Model.BookingReference/request-location"><button class="sp-btn sp-btn--primary">Request app check-in</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/InApp"><button class="sp-btn sp-btn--success">Send In-App Alert</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/WhatsApp?mode=demo"><button class="sp-btn sp-btn--outline">Optional simulated WhatsApp</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/WhatsApp"><button class="sp-btn sp-btn--outline" disabled="@liveDisabled">Optional LiveTest WhatsApp</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="ARRIVED_STAGING"/><button class="sp-btn sp-btn--outline">Move to Staging</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="PROCEEDING_GATE"/><button class="sp-btn sp-btn--outline">Release to Gate</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="DELAYED 20"/><button class="sp-btn sp-btn--warning">Reschedule</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="ISSUE"/><button class="sp-btn sp-btn--warning">Mark Exception</button></form></div>@if(liveDisabled){<p class="sp-alert sp-alert--warning">LiveTest WhatsApp disabled: @disabledReason</p>}<form method="post" action="/fleet/trucks/@Model.BookingReference/copilot" class="sp-form-inline"><input name="question" value="What should I tell this driver now?"/><button class="sp-btn sp-btn--primary">Ask Copilot</button></form></article>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Status, check-in and audit history</h2><dl class="driver-dl"><dt>Latest driver status</dt><dd>@Model.CurrentStatus</dd><dt>Latest instruction</dt><dd>@Model.CurrentInstruction.Instruction</dd><dt>ETA/call-forward</dt><dd>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Idling / CO₂ impact</dt><dd>@Model.EstimatedIdlingMinutesAvoided min / @Model.EstimatedCo2KgAvoided.ToString("N1") kg</dd></dl>@foreach(var step in Model.Timeline.OrderByDescending(s=>s.Timestamp)){<div class="timeline-step"><strong>@step.Status</strong><span>@step.Timestamp.ToLocalTime().ToString("HH:mm")</span><p>@step.Note</p></div>}</article><article class="sp-card"><h2>Driver communication timeline</h2>@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp)){<div class="notification-row sp-notification-row"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><p>@n.Message</p><small>@n.Timestamp.ToLocalTime().ToString("g")</small></div>}</article></div>

<article class="sp-card sp-mt"><h2>Audit trail</h2>@foreach(var a in Model.AuditTrail.OrderByDescending(a=>a.Timestamp)){<div class="timeline-step"><strong>@a.EventType</strong><span>@a.Timestamp.ToLocalTime().ToString("g")</span><p>@a.PublicSafeNote @a.Reason</p><small>@a.Actor · @a.Source</small></div>}</article>
