@using SmartPort.Application.DTOs
@model FleetTruckDto
@{ ViewData["Title"] = $"Truck {Model.TruckRegistration}"; }
<div class="sp-toolbar"><div><h1>@Model.TruckRegistration</h1><p>@Model.DriverName · @Model.FleetOperatorName · @Model.BookingReference</p></div><a href="/driver/status/@Model.BookingReference" class="sp-btn sp-btn--outline">Open driver view</a></div>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Current AI movement instruction</h2><p class="driver-instruction">@Model.CurrentInstruction.Instruction</p><p>@Model.CurrentInstruction.Explanation</p><dl class="driver-dl"><dt>Reason</dt><dd>@Model.CurrentInstruction.Reason</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Idling avoided</dt><dd>@Model.EstimatedIdlingMinutesAvoided min</dd><dt>CO₂ avoided</dt><dd>@Model.EstimatedCo2KgAvoided.ToString("N1") kg</dd></dl></article><article class="sp-card"><h2>Driver / appointment</h2><dl class="driver-dl"><dt>Contact placeholder</dt><dd>@Model.DriverContactPlaceholder</dd><dt>Container/job</dt><dd>@Model.ContainerReference / @Model.JobReference</dd><dt>Appointment</dt><dd>@Model.AppointmentTime.ToLocalTime().ToString("f")</dd><dt>Queue</dt><dd>@Model.QueueNumber</dd><dt>Gate & zone</dt><dd>@Model.AssignedGate · @Model.BerthYardStagingZone</dd></dl><div class="qr-placeholder">QR / gate ref: @Model.BookingReference</div></article></div>
<article class="sp-card"><h2>Actions</h2><form method="post" action="/fleet/notify/@Model.BookingReference/InApp" class="inline-form"><button class="sp-btn sp-btn--success">Send in-app alert</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/WhatsApp" class="inline-form"><button class="sp-btn sp-btn--primary">Simulate WhatsApp notification</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/AndroidPush" class="inline-form"><button class="sp-btn sp-btn--outline">Simulate Android app notification</button></form></article>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Status history</h2>@foreach(var step in Model.Timeline){<div class="timeline-step"><strong>@step.Status</strong><span>@step.Timestamp.ToLocalTime().ToString("HH:mm")</span><p>@step.Note</p></div>}</article><article class="sp-card"><h2>Notification history</h2>@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp)){<div class="notification-row"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><p>@n.Message</p><small>@n.Timestamp.ToLocalTime().ToString("g")</small></div>}</article></div>
