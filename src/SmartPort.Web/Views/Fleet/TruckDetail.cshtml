@using SmartPort.Application.DTOs
@model FleetTruckDto
@{
    ViewData["Title"] = $"Truck {Model.TruckRegistration}";
    var wa = ViewBag.WhatsAppStatus as WhatsAppConnectorStatusDto ?? new();
    string disabledReason = wa.Mode != WhatsAppMode.LiveTest ? "WhatsApp mode is not LiveTest" : !wa.Enabled ? "WhatsApp not enabled" : !wa.AccessTokenConfigured ? "Access token missing" : !wa.PhoneNumberIdConfigured ? "Phone number ID missing" : !Model.DriverContact.IsActive ? "Driver not active" : !Model.DriverContact.TestApproved ? "Driver not Test Approved" : !Model.DriverContact.WhatsAppConsentConfirmed ? "WhatsApp Consent Confirmed false" : string.IsNullOrWhiteSpace(Model.DriverContact.NormalizedWhatsAppNumber) || !Model.DriverContact.NormalizedWhatsAppNumber.StartsWith("+") ? "Invalid WhatsApp number" : Model.DriverContact.IsDemoSeedRecord ? "Seeded demo driver/contact" : string.Empty;
    var liveDisabled = !string.IsNullOrWhiteSpace(disabledReason);
}
<div class="sp-toolbar"><div><h1>@Model.TruckRegistration operations console</h1><p>@Model.DriverName · @Model.FleetOperatorName · @Model.BookingReference</p></div><a href="/driver/status/@Model.BookingReference" class="sp-btn sp-btn--outline">View Driver Page</a></div>
@if (TempData["Success"] is string ok){<div class="sp-alert sp-alert--success">@ok</div>}@if (TempData["Warning"] is string warn){<div class="sp-alert sp-alert--warning">@warn</div>}@if (TempData["CopilotAnswer"] is string answer){<div class="sp-alert sp-alert--success"><strong>Copilot:</strong> @answer</div>}
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Current AI movement instruction</h2><p class="driver-instruction">@Model.CurrentInstruction.Instruction</p><p>@Model.CurrentInstruction.Explanation</p><dl class="driver-dl"><dt>Reason</dt><dd>@Model.CurrentInstruction.Reason</dd><dt>Status</dt><dd>@Model.CurrentStatus</dd><dt>Delay risk</dt><dd>@Model.DelayRisk</dd><dt>Call-forward</dt><dd>@Model.EtaCallForwardTime.ToLocalTime().ToString("HH:mm")</dd><dt>Idling avoided</dt><dd>@Model.EstimatedIdlingMinutesAvoided min</dd><dt>CO₂ avoided</dt><dd>@Model.EstimatedCo2KgAvoided.ToString("N1") kg</dd></dl></article><article class="sp-card"><h2>Driver / appointment</h2><dl class="driver-dl"><dt>Contact readiness</dt><dd>@Model.DriverContact.ValidationMessage</dd><dt>WhatsApp safe</dt><dd>@(Model.DriverContact.IsLiveWhatsAppSafe ? "Yes" : "No")</dd><dt>Container/job</dt><dd>@Model.ContainerReference / @Model.JobReference</dd><dt>Appointment</dt><dd>@Model.AppointmentTime.ToLocalTime().ToString("f")</dd><dt>Queue</dt><dd>@Model.QueueNumber</dd><dt>Gate & zone</dt><dd>@Model.AssignedGate · @Model.BerthYardStagingZone</dd><dt>Last location</dt><dd>@Model.LastKnownLocationLabel</dd></dl><div class="qr-placeholder">QR / gate ref: @Model.BookingReference</div></article></div>
<article class="sp-card"><h2>Fleet owner actions</h2><div class="ack-grid"><form method="post" action="/fleet/trucks/@Model.BookingReference/request-location"><button class="sp-btn sp-btn--outline" disabled="@liveDisabled">Request LiveTest Location</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/WhatsApp?mode=demo"><button class="sp-btn sp-btn--primary">Send Simulated WhatsApp</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/WhatsApp"><button class="sp-btn sp-btn--success" disabled="@liveDisabled">Send LiveTest WhatsApp</button></form><form method="post" action="/fleet/notify/@Model.BookingReference/InApp"><button class="sp-btn sp-btn--success">Send In-App Alert</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="ARRIVED_STAGING"/><button class="sp-btn sp-btn--outline">Move to Staging</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="PROCEEDING_GATE"/><button class="sp-btn sp-btn--outline">Release to Gate</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="DELAYED 20"/><button class="sp-btn sp-btn--warning">Reschedule</button></form><form method="post" action="/fleet/trucks/@Model.BookingReference/action"><input type="hidden" name="commandText" value="ISSUE"/><button class="sp-btn sp-btn--warning">Mark Exception</button></form></div>@if(liveDisabled){<p class="sp-alert sp-alert--warning">LiveTest WhatsApp disabled: @disabledReason</p>}<form method="post" action="/fleet/trucks/@Model.BookingReference/copilot" class="sp-form-inline"><input name="question" value="What should I tell this driver now?"/><button class="sp-btn sp-btn--primary">Ask Copilot</button></form></article>
<div class="sp-grid sp-grid--2"><article class="sp-card"><h2>Status history</h2>@foreach(var step in Model.Timeline.OrderByDescending(s=>s.Timestamp)){<div class="timeline-step"><strong>@step.Status</strong><span>@step.Timestamp.ToLocalTime().ToString("HH:mm")</span><p>@step.Note</p></div>}</article><article class="sp-card"><h2>Notification history</h2>@foreach(var n in Model.NotificationHistory.OrderByDescending(n=>n.Timestamp)){<div class="notification-row"><span class="sp-badge sp-badge--ai">@n.Channel</span><strong>@n.Status</strong><p>@n.Message</p><small>@n.Timestamp.ToLocalTime().ToString("g")</small></div>}</article></div>
