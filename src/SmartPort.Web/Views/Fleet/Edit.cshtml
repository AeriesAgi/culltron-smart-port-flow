@using SmartPort.Application.Interfaces
@model SaveFleetVehicleDto
@{ ViewData["Title"] = "Edit Vehicle"; var orgs = ViewBag.Organisations as IEnumerable<OrganisationListDto> ?? []; }
<div class="sp-form-page">
  <div class="sp-card sp-card--form">
    <div class="sp-card__header"><h3 class="sp-card__title">Edit Fleet Vehicle</h3></div>
    <form asp-action="Edit" asp-controller="Fleet" asp-route-id="@ViewBag.VehicleId" method="post">
      @Html.AntiForgeryToken()
      <div class="sp-form__grid sp-form__grid--2">
        <div class="sp-form__group">
          <label class="sp-form__label">Organisation *</label>
          <select asp-for="OrganisationId" class="sp-form__select">
            @foreach(var o in orgs){<option value="@o.Id">@o.Name</option>}
          </select>
        </div>
        <div class="sp-form__group"><label class="sp-form__label">Registration Number *</label><input asp-for="RegistrationNumber" class="sp-form__input"/></div>
        <div class="sp-form__group"><label class="sp-form__label">Fleet Number</label><input asp-for="FleetNumber" class="sp-form__input"/></div>
        <div class="sp-form__group"><label class="sp-form__label">Vehicle Type</label><select asp-for="VehicleType" class="sp-form__select">@foreach(var t in Enum.GetValues<SmartPort.Domain.Enums.FleetVehicleType>()){<option value="@t">@t</option>}</select></div>
        <div class="sp-form__group"><label class="sp-form__label">Cargo Type</label><select asp-for="CargoType" class="sp-form__select">@foreach(var t in Enum.GetValues<SmartPort.Domain.Enums.FleetCargoType>()){<option value="@t">@t</option>}</select></div>
        <div class="sp-form__group"><label class="sp-form__label">Capacity (tonnes)</label><input asp-for="CapacityTons" class="sp-form__input" type="number" step="0.5"/></div>
        <div class="sp-form__group"><label class="sp-form__label">Status</label><select asp-for="Status" class="sp-form__select">@foreach(var s in Enum.GetValues<SmartPort.Domain.Enums.FleetVehicleStatus>()){<option value="@s">@s</option>}</select></div>
        <div class="sp-form__group"><label class="sp-form__label">Current Location</label><input asp-for="CurrentLocation" class="sp-form__input"/></div>
      </div>
      <div class="sp-form__footer">
        <a asp-action="Detail" asp-controller="Fleet" asp-route-id="@ViewBag.VehicleId" class="sp-btn sp-btn--outline">Cancel</a>
        <button type="submit" class="sp-btn sp-btn--primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>
