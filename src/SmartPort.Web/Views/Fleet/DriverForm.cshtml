@using SmartPort.Application.DTOs
@model SaveDriverContactRequestDto
@{ ViewData["Title"] = "Driver WhatsApp Contact"; var fleets = ViewBag.FleetOperators as IReadOnlyList<FleetOperatorDto> ?? Array.Empty<FleetOperatorDto>(); var trucks = ViewBag.Trucks as IReadOnlyList<FleetTruckDto> ?? Array.Empty<FleetTruckDto>(); var status = ViewBag.WhatsAppStatus as WhatsAppConnectorStatusDto ?? new(); }
<section class="sp-page-hero fleet-hero"><div><span class="sp-badge sp-badge--ai">WhatsApp-safe capture</span><h1>Add/edit driver contact</h1><p>Require country code and only allow LiveTest sends when consent + test approval are checked.</p></div></section>
<div class="sp-alert sp-alert--info">Live WhatsApp messages are only sent to approved test numbers. Current mode: <strong>@status.Mode</strong>.</div>
<form method="post" action="/fleet/drivers" class="sp-card sp-card--form"><div class="sp-form__grid sp-form__grid--2"><div class="sp-form__group"><label class="sp-form__label">Driver name *</label><input class="sp-form__input" name="DriverName" required /></div><div class="sp-form__group"><label class="sp-form__label">WhatsApp country code *</label><input class="sp-form__input" name="WhatsAppCountryCode" placeholder="+27" required /></div><div class="sp-form__group"><label class="sp-form__label">WhatsApp number *</label><input class="sp-form__input" name="WhatsAppNumber" placeholder="82 123 4567" required /></div><div class="sp-form__group"><label class="sp-form__label">Backup contact</label><input class="sp-form__input" name="BackupContact" /></div><div class="sp-form__group"><label class="sp-form__label">Fleet</label><select class="sp-form__select" name="AssignedFleetOperatorId">@foreach(var f in fleets){<option value="@f.Id">@f.Name</option>}</select></div><div class="sp-form__group"><label class="sp-form__label">Truck</label><select class="sp-form__select" name="AssignedTruckRegistration">@foreach(var t in trucks){<option value="@t.TruckRegistration">@t.TruckRegistration · @t.BookingReference</option>}</select></div></div><label><input type="checkbox" name="TestApproved" value="true" /> Test Approved</label><label><input type="checkbox" name="WhatsAppConsentConfirmed" value="true" /> WhatsApp Consent Confirmed</label><input type="hidden" name="IsActive" value="true"/><div class="sp-form__footer"><button class="sp-btn sp-btn--primary">Save driver</button></div></form>
